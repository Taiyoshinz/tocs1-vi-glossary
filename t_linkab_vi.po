msgid "ラッシュⅡ"
msgstr "Liên Kích 2"

#. Increases the power of Rush.
msgctxt "#64 desc"
msgid "ラッシュの威力が向上する。"
msgstr "Gia tăng uy lực của Liên Kích."

msgctxt "#65 name"
msgid "止めの一撃"
msgstr "Đòn Dứt Điểm"

msgctxt "#65 desc"
msgid "リンクアタック－追撃の後、残ＨＰの少ない敵に止めを刺す。"
msgstr "Hạ gục kẻ địch sau đòn Truy Kích nếu chúng còn ít HP."

msgctxt "#66 name"
msgid "反撃"
msgstr "Phản Kích"

msgctxt "#66 desc"
msgid "パートナーが攻撃されると、一定確率で反撃。"
msgstr "Có tỉ lệ phản đòn khi cộng sự bị tấn công."

msgctxt "#67 name"
msgid "渾身の一撃"
msgstr "Tấn Công Dồn Lực"

msgctxt "#67 desc"
msgid "止めの一撃の威力が増し、発生しやすくなる（ダメージ２倍）。"
msgstr "Nâng cao tỉ lệ phát động và uy lực của Đòn Dứt Điểm."

msgctxt "#68 name"
msgid "ラッシュⅡ"
msgstr "Liên Kích 2"

msgctxt "#68 desc"
msgid "リンクアタック－ラッシュがより強力になる。"
msgstr "Gia tăng uy lực của Liên Kích."

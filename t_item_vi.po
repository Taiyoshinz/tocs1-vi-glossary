msgid "Refreshing Pasta Soup"
msgstr "Pasta Lạnh Thanh Mát"

msgctxt "#1027 desc"
msgid ""
"[Restores 2600 HP/Restores 50 EP/Cures Burn]\n"
"A pasta soup that fills your mouth with a refreshing aroma."
msgstr ""
"[Hồi 2600 HP/Hồi 50 HP/Giải Trừ Thiêu Đốt]\n"
"Pasta súp lạnh thanh mát như làn gió, tỏa hương ngập tràn khoang miệng."

msgctxt "#1028 name"
msgid "Hashed Beef Rice"
msgstr "Cơm Bò Bằm Kiểu Quân Đội"

msgctxt "#1028 desc"
msgid ""
"[Restores 3000 HP/Restores 10 CP/SPD+25% (3 Turns)]\n"
"A meal served once a week in the Imperial Army."
msgstr ""
"[Hồi 3000 HP/Hồi 10 CP/TĐ+25% (3 lượt)]\n"
"Món cơm chỉ được phục vụ một tuần một lần trong Quân Đội Đế Quốc."

msgctxt "#1029 name"
msgid "Stamina Steak"
msgstr "Bít Tết Năng Lượng"

msgctxt "#1029 desc"
msgid ""
"[Restores 3600 HP/STR/DEF+25% (3 Turns)]\n"
"A steak with added spices to stimulate your appetite."
msgstr ""
"[Hồi 3600 HP/SM/PT+25％ (3 lượt)]\n"
"Bít tết kích thích vị giác mạnh mẽ nhờ sự kết hợp hài hòa của gia vị."

msgctxt "#1030 name"
msgid "Tomato Cocktail"
msgstr "Cocktail Cà Chua"

msgctxt "#1030 desc"
msgid ""
"[Restores 2600 HP/Restores 30 CP]\n"
"A healthy, non-alcoholic cocktail made with acerbic tomatoes."
msgstr ""
"[Hồi 2600 HP/Hồi 30 HP]\n"
"Cocktail không cồn tốt cho sức khỏe, được làm từ cà chua đắng."

msgctxt "#1031 name"
msgid "Mixed Gelato"
msgstr "Gelato Hỗn Hợp"

msgctxt "#1031 desc"
msgid ""
"[Restores 2000 HP/Restores 100 EP/Cures K.O.]\n"
"Gelato made with a perfect balance of different flavors."
msgstr ""
"[Giải Trừ Gục Ngã/Hồi 2000 HP/Hồi 100 EP]\n"
"Món kem gelato có sự cân bằng xuất sắc giữa các tầng hương vị."

msgctxt "#1032 name"
msgid "Filling Hotpot"
msgstr "Lẩu No Nê"

msgctxt "#1032 desc"
msgid ""
"[Restores 7000 HP/STR/ATS/SPD+25% (3 Turns)]\n"
"A filling hotpot that's bursting with meat and vegetables."
msgstr ""
"[Hồi 7000 HP/SM/PL/TĐ+25％ (3 lượt)]\n"
"Nồi lẩu đầy ắp thịt và các loại rau củ."

msgctxt "#1033 name"
msgid "Handmade Hamburger"
msgstr "Hamburg Nhà Làm"

msgctxt "#1033 desc"
msgid ""
"[Restores 6000 HP/Restores 10 CP/STR/DEF+25% (5 Turns)]\n"
"A delicious hamburger with a hand-shaped patty."
msgstr ""
"[Hồi 6000 HP/Hồi 10 CP/SM/PT+25％ (5 lượt)]\n"
"Harmburg được làm tay vô cùng công phu."

msgctxt "#1034 name"
msgid "Solid Omelet"
msgstr "Trứng Cuộn Siêu Cứng"

msgctxt "#1034 desc"
msgid ""
"[Restores 400 HP/DEF+25% (3 Turns)]\n"
"Resembles an omelet, although it's far too chewy to be one."
msgstr ""
"[Hồi HP400/PT+25% (3 lượt)]\n"
"Trông giống trứng cuộn, nhưng dai tới mức thách thức răng người nhai."

msgctxt "#1035 name"
msgid "Yellow Liquid"
msgstr "Dung Dịch Màu Vàng"

msgctxt "#1035 desc"
msgid ""
"[Restores 100 EP]\n"
"A mysterious yellow liquid made up of liquefied orbal energy."
msgstr ""
"[Hồi 100 EP]\n"
"Thứ chất lỏng có màu vàng kỳ quái thấm đẫm năng lượng dẫn lực."

msgctxt "#1036 name"
msgid "Bitter Sandwich"
msgstr "Sandwich Đắng Ngắt"

msgctxt "#1036 desc"
msgid ""
"[Restores 100 HP/Restores 40 CP]\n"
"A highly bitter sandwich. You either love it or hate it."
msgstr ""
"[Hồi 100 HP/Hồi 40 CP]\n"
"Sandwich có vị đắng ngắt. Người thích thì thích, người chê thì chê."

msgctxt "#1037 name"
msgid "Brown Liquid"
msgstr "Dung Dịch Màu Nâu"

msgctxt "#1037 desc"
msgid ""
"[Restores 200 EP]\n"
"Liquid with an odd smell. Made up of liquefied orbal energy."
msgstr ""
"[Hồi 200 EP]\n"
"Dung dịch màu nâu có mùi khó tả, thấm đẫm năng lượng dẫn lực."

msgctxt "#1038 name"
msgid "Elementart"
msgstr "Bánh Tart Đơn Điệu"

msgctxt "#1038 desc"
msgid ""
"[Restores 1200 HP/ATS+25% (5 Turns)]\n"
"A simple yet stylish tart."
msgstr ""
"[Hồi 1200 HP/PL+25％ (5 lượt)]\n"
"Bánh tart siêu đơn giản, nhưng rất có kiểu cách."

msgctxt "#1039 name"
msgid "Soggy Porridge"
msgstr "Cháo Cấp Ẩm"

msgctxt "#1039 desc"
msgid ""
"[Restores 800 HP/DEF/ADF+50% (3 Turns)]\n"
"Porridge that has a little too much moisture."
msgstr ""
"[Hồi HP800/PT/PA+50％ (3 lượt)]\n"
"Món cháo có độ ẩm cực cao."

msgctxt "#1040 name"
msgid "Mirror Pizza"
msgstr "Pizza Phản Chiếu"

msgctxt "#1040 desc"
msgid ""
"[Restores 50 EP/Magic Reflect]\n"
"A circular pizza with a strange shine to it."
msgstr ""
"[Hồi 50 EP/Phản Phép]\n"
"Pizza có hình dĩa tròn tỏa sáng một cách kỳ lạ."

msgctxt "#1041 name"
msgid "Black Liquid"
msgstr "Dung Dịch Màu Đen"

msgctxt "#1041 desc"
msgid ""
"[Restores 250 EP]\n"
"A black liquid made up of liquefied orbal energy."
msgstr ""
"[Hồi 250 HP]\n"
"Chất lỏng đen ngòm, thấm đẫm năng lượng dẫn lực."

msgctxt "#1042 name"
msgid "Magma Gratin"
msgstr "Gratin Nham Thạch"

msgctxt "#1042 desc"
msgid ""
"[Restores 200 HP/Restores 50 CP]\n"
"A gratin with a surface that boils like magma."
msgstr ""
"[Hồi 200 HP/Hồi 50 CP]\n"
"Đĩa Gratin sôi sùng sục như một dòng nham thạch phun trào."

msgctxt "#1043 name"
msgid "Egg Custard Pudding"
msgstr "Pudding Trứng Hấp"

msgctxt "#1043 desc"
msgid ""
"[Restores 600 HP/Insight (5 Turns)]\n"
"Eastern-styled pudding. Seems ordinary until you take a bite."
msgstr ""
"[Hồi 600 HP/Tâm Nhãn (5 lượt)]\n"
"Món pudding phương Đông có vẻ ngoài bình thường, nhưng vị thì khác biệt."

msgctxt "#1044 name"
msgid "Colorless Noodles"
msgstr "Mỳ Trắng Tinh"

msgctxt "#1044 desc"
msgid ""
"[Restores 2400 HP/STR/SPD+25% (3 Turns)]\n"
"Simple noodles with none of the taste of their ingredients."
msgstr ""
"[Hồi 2400 HP/SM/TĐ+25％ (3 lượt)]\n"
"Món pasta nước nhạt nhẽo đến mức chẳng cảm nhận được mùi vị gì."

msgctxt "#1045 name"
msgid "Adamantine Steak"
msgstr "Bít Tết Adamantine"

msgctxt "#1045 desc"
msgid ""
"[Restores 1000 HP/Physical Immunity]\n"
"A lump of meat that's as hard as rock."
msgstr ""
"[Hồi 1000 HP/Miễn Vật Lý]\n"
"Khối thịt cứng như đá."

msgctxt "#1046 name"
msgid "Red Liquid"
msgstr "Dung Dịch Màu Đỏ"

msgctxt "#1046 desc"
msgid ""
"[Restores 300 EP/Restores 45 CP]\n"
"Liquefied orbal energy. Has a pungent smell."
msgstr ""
"[Hồi 300 EP/Hồi 45 CP]\n"
"Dung dịch màu đỏ kích thích khứu giác, thấm đẫm năng lượng dẫn lực."

msgctxt "#1047 name"
msgid "Wonder Gelato"
msgstr "Gelato Kỳ Diệu"

msgctxt "#1047 desc"
msgid ""
"[Restores 500 HP/150EP/Cures abnormal status/Stat Down]\n"
"A mysterious, very soft to the touch gelato."
msgstr ""
"[Hồi 500HP/150EP/Giải Trừ Suy Giảm/Trạng Thái Dị Thường/]\n"
"Món gelato mềm mại bí ẩn."

msgctxt "#1048 name"
msgid "Enigmatic Hotpot"
msgstr "Lẩu Bóng Đêm <Gan Hùm>"

msgctxt "#1048 desc"
msgid ""
"[Restores 500 EP/Either restores 100 CP or causes Near-Death]\n"
"A mysterious hotpot. It smells dangerous."
msgstr ""
"[Hồi 500 EP/Hồi 100CP hoặc rơi vào trạng thái Lâm Nguy]\n"
"Nồi lẩu có mùi nguy hiểm, mọi nguyên liệu đều là ẩn số."

msgctxt "#1049 name"
msgid "Warm Egg Soup"
msgstr "Súp Trứng Ấm"

msgctxt "#1049 desc"
msgid ""
"[Restores 600 HP/STR+25% (3 Turns)/Cures Freeze]\n"
"A soup that warms you from head to toe from the first sip."
msgstr ""
"[Hồi 600 HP/SM+25%/Giải Trừ Đóng Băng]\n"
"Món súp trứng ấm áp mềm mại, giúp sưởi ấm tâm can."

msgctxt "#1050 name"
msgid "White Cookie"
msgstr "Bánh Lưỡi Mèo Trắng"

msgctxt "#1050 desc"
msgid ""
"[Restores 800 HP/Cures Poison/Burn]\n"
"A high-class cookie with luxurious white chocolate inside."
msgstr ""
"[Hồi 800 HP/Giải Trừ Độc/Thiêu Đốt]\n"
"Món bánh quy tuyệt phẩm với lớp socola trắng kẹp ở giữa."

msgctxt "#1051 name"
msgid "Wild Mix"
msgstr "Nước Ép Hoang Dã"

msgctxt "#1051 desc"
msgid ""
"[Restores 1000 HP/Restores 50 EP/Cures Faint/Confuse]\n"
"A mixed juice made by randomly adding ingredients."
msgstr ""
"[Hồi 1000HP/Hồi 50 EP/Giải Trừ Ngất/Loạn Trí]\n"
"Nước ép hỗ hợp được pha trộn theo tiếng gọi của tự nhiên."

msgctxt "#1052 name"
msgid "Victory Sandwich"
msgstr "Sandwich Chiến Thắng"

msgctxt "#1052 desc"
msgid ""
"[Restores 1500 HP/Restores 25 CP/STR+25% (3 Turns)]\n"
"A sandwich made with plenty of meat. Fills you with energy."
msgstr ""
"[Hồi 1500 HP/Hồi 25 CP/SM+25％ (3 lượt)]\n"
"Sandwich kẹp thịt chiên xù, khơi dậy tinh thần chiến đấu."

msgctxt "#1053 name"
msgid "Nord Tea"
msgstr "Trà Nord"

msgctxt "#1053 desc"
msgid ""
"[Restores 1600 HP/SPD+25% (3 Turns)]\n"
"A variety of herb tea long loved by the people of Nord."
msgstr ""
"[Hồi 1600 HP/TĐ+25％ (3 lượt)]\n"
"Trà thảo mộc được người dân Nord yêu thích từ thời xa xưa."

msgctxt "#1054 name"
msgid "Deluxe Herb Chowder"
msgstr "Súp Kem Thảo Mộc Đặc Chế"

msgctxt "#1054 desc"
msgid ""
"[Restores 2000 HP/Cures Poison/Blind/Burn/Freeze]\n"
"Full of ingredients. The herbs' aroma whets the appetite."
msgstr ""
"[Hồi 2000 HP/Giải Trừ Độc/Mù Lòa/Thiêu Đốt/Đóng Băng]\n"
"Món súp ngập tràn nguyên liệu, kích thích vị giác nhờ các loại thảo mộc."

msgctxt "#1055 name"
msgid "Soft Chocolate Tart"
msgstr "Bánh Tart Socola Mềm Mịn"

msgctxt "#1055 desc"
msgid ""
"[Restores 2400 HP/Cures Freeze/Petrify]\n"
"Uses only the finest chocolate. Looks as good as it tastes."
msgstr ""
"[Hồi 2400 HP/Giải Trừ Đóng Băng/Hóa Đá]\n"
"Bánh tart chuẩn vị được làm từ socola thượng hạng."

msgctxt "#1056 name"
msgid "Three Cheese Risotto"
msgstr "Risotto Chân Thành"

msgctxt "#1056 desc"
msgid ""
"[Restores 1200 HP/STR/ATS+25% (5 Turns)]\n"
"A perfectly crafted risotto containing a variety of cheeses."
msgstr ""
"[Hồi 1200 HP/SM/PL+25％ (5 lượt)]\n"
"Món Risotto được nấu từ nhiều loại phô mai, chứa đựng tấm chân tình."

msgctxt "#1057 name"
msgid "Teriyaki Chicken Pizza"
msgstr "Pizza Gà Teriyaki"

msgctxt "#1057 desc"
msgid ""
"[Restores 2400 HP/Restores 25 CP/DEF/SPD+25% (3 Turns)]\n"
"An Eastern-style chicken pizza with plenty of flavorful sauce."
msgstr ""
"[Hồi 2400 HP/Hồi 25 CP/PT/TĐ+25％ (3 lượt)]\n"
"Pizza kphương Đông với lớp nước xốt đậm đà phủ đầy."

msgctxt "#1058 name"
msgid "Double Espresso"
msgstr "Espresso Đậm Đặc"

msgctxt "#1058 desc"
msgid ""
"[Restores 2400 HP/Cures Sleep/Nightmare/Faint/Confuse]\n"
"A special kind of espresso made with rare, dark-roasted beans."
msgstr ""
"[Hồi 2400 HP/Giải Trừ Ngủ Mê/Ác Mộng/Ngất/Loạn Trí]\n"
"Espresso đặc biệt, được rang kỹ từ hạt cà phe hiếm."

msgctxt "#1059 name"
msgid "Whole Pumpkin Gratin"
msgstr "Gratin Nguyên Quả Bí Đỏ"

msgctxt "#1059 desc"
msgid ""
"[Restores 2000 HP/Restores 25 CP/ATS+50% (3 Turns)]\n"
"A gratin full of pumpkin, served in a hollowed-out pumpkin."
msgstr ""
"[Hồi 2000 HP/Hồi 25 CP/PL+50％ (3 lượt)]\n"
"Món gratin được phục vụ trong chính quả bí ngô."

msgctxt "#1060 name"
msgid "Fish Nuggets"
msgstr "Cá Viên Một Miếng"

msgctxt "#1060 desc"
msgid ""
"[Restores 3600 HP/SPD+50% (3 Turns)]\n"
"Charmingly bite-sized nuggets of fried fish."
msgstr ""
"[Hồi HP3600/TĐ+50％ (3 lượt]\n"
"Món cá viên nhỏ nhắn dễ thương, ăn trọn trong một miếng."

msgctxt "#1061 name"
msgid "Quartet Pudding"
msgstr "Pudding Tứ Sắc"

msgctxt "#1061 desc"
msgid ""
"[Restores 1400 HP/STR/DEF/ATS/ADF+25% (4 Turns)]\n"
"A carefully crafted pudding with four perfectly fused sauces."
msgstr ""
"[Hồi 1400 HP/SM/PT/PL/PA+25％ (4 lượt)]\n"
"Pudding tối thượng mang đến sự hòa quyện từ 4 loại xốt khác nhau."

msgctxt "#1062 name"
msgid "Deluxe Herb Pasta"
msgstr "Pasta Thảo Mộc Đặc Chế"

msgctxt "#1062 desc"
msgid ""
"[Restores 1800 HP/Restores 100 EP/Cures abnormal status]\n"
"Herb pasta known for its unique, addictive fragrance."
msgstr ""
"[Hồi HP1800/Hồi 100 EP/Giải Trừ Trạng Thái Dị Thường]\n"
"Súp pasta khiến người ta phải liên tưởng đến nhiều loại thảo mộc độc đáo."

msgctxt "#1063 name"
msgid "Artistic Omurice"
msgstr "Cơm Trứng Sáng Tạo"

msgctxt "#1063 desc"
msgid ""
"[Restores 3600 HP/Restores 20 CP/DEF/ADF+50% (3 Turns)]\n"
"A playful omelet with a picture drawn in sauce on top of it."
msgstr ""
"[Hồi 3600 HP/Hồi 20 CP/PT/PA+50％]\n"
"Món cơm trứng được trang trí bằng những nét vẽ từ nước xốt."

msgctxt "#1064 name"
msgid "Juicy Kebab"
msgstr "Kebab Mọng Nước"

msgctxt "#1064 desc"
msgid ""
"[Restores 5200 HP/STR+50% (5 Turns)]\n"
"A kebab bursting with juices, with delicious-smelling sauce."
msgstr ""
"[Hồi 5200 HP/SM+50％ (5 lượt]\n"
"Kebab kích thích vị giác nhờ hương thơm nức mũi từ xốt và nước thịt."

msgctxt "#1065 name"
msgid "Red Hot Soda"
msgstr "Soda Cay Nồng"

msgctxt "#1065 desc"
msgid ""
"[Restores 2200 HP/Restores 60 CP]\n"
"A stimulating drink that gets its taste from the spices used."
msgstr ""
"[Hồi 2200HP/Hồi 60 CP]\n"
"Món đồ uống kích thích vị giác nhờ các hương liệu bí mật."

msgctxt "#1066 name"
msgid "Salty Gelato"
msgstr "Gelato Biển Xanh"

msgctxt "#1066 desc"
msgid ""
"[Restores 2500 HP/Restores 50 EP/25 CP/Cures K.O.]\n"
"A pretty blue salted gelato. As nice to look at as to eat."
msgstr ""
"[Giải Trừ Gục Ngã/Hồi 2500 HP/50 EP/25 CP]\n"
"Món kem gelato được phủ muối xanh, mang lại cảm giác thanh mát."

msgctxt "#1067 name"
msgid "Hurricane Hotpot"
msgstr "Lẩu Cuồng Phong"

msgctxt "#1067 desc"
msgid ""
"[Restores 2500 HP/Restores 150 EP/45 CP/STR/SPD+50% (5 Turns)]\n"
"A simple, flavorful hot pot made using delicious stock."
msgstr ""
"[Hồi 2500 HP/150 EP/45 CP/SM/TĐ+50％ (5 lượt)]\n"
"Nồi lẩu thanh đạm, lột tả trọn vẹn vị của nước dùng."

msgctxt "#1068 name"
msgid "Mixed Hamburger Dish"
msgstr "Hamburg Sắc Màu"

msgctxt "#1068 desc"
msgid ""
"[Restores 8000 HP/Restores 30 CP/ATS/ADF+50% (5 Turns)]\n"
"A dish perfectly balanced for variety and nutrition."
msgstr ""
"[Hồi 8000 HP/Hồi 30 CP/PL/PA+50％]\n"
"Món ăn tối thượng, cân bằng hoàn hảo từ màu sắc cho đến dinh dưỡng."

msgctxt "#1069 name"
msgid "Fresh Egg"
msgstr "Trứng tươi"

msgctxt "#1069 desc"
msgid ""
"A freshly laid egg. The yellow yolk inside is highly\n"
"nutritious."
msgstr ""
"Trứng tươi vừa được thu hoạch vào ban sáng.\n"
"Lòng đỏ bắt mắt và tràn đầy dinh dưỡng."

msgctxt "#1070 name"
msgid "Fresh Milk"
msgstr "Sữa tươi"

msgctxt "#1070 desc"
msgid ""
"Freshly drawn milk. Soft and pleasant on the tongue with a\n"
"hint of sweetness."
msgstr ""
"Sữa tươi vừa mới vắt.\n"
"Mang lại cảm giác mượt mà nơi đầu lưỡi và vị ngọt thanh."

msgctxt "#1071 name"
msgid "Mature Cheese"
msgstr "Phô mai ủ lâu"

msgctxt "#1071 desc"
msgid ""
"Matured cheese with a deep flavor. Delicious both on its own\n"
"and when used for cooking."
msgstr ""
"Phô mai được ủ kỹ mang đến hương vị đậm đà.\n"
"Dùng để nhế biến hay ăn trực tiếp đều ngon."

msgctxt "#1072 name"
msgid "Fresh Herb"
msgstr "Thảo mộc tươi"

msgctxt "#1072 desc"
msgid ""
"A herb with a refreshing fragrance. Used for a variety of\n"
"purposes, from removing odors from meats to making herb tea."
msgstr ""
"Thảo mộc tỏa ra hương thơm sảng khoái.\n"
"Có thể dùng để khử mùi tanh của thịt cho đến dùng để pha trà."

msgctxt "#1073 name"
msgid "Crisp Onion"
msgstr "Hành tây giòn"

msgctxt "#1073 desc"
msgid ""
"A large onion with a crisp texture. Not all that pungent, so\n"
"it can be eaten as it is."
msgstr ""
"Củ hành to mang lại cảm giác giòn sần sật khi nhai.\n"
"Hầu như không có vị hăng cay nên có thể ăn sống trực tiếp."

msgctxt "#1074 name"
msgid "Flaky Potato"
msgstr "Khoai tây bở"

msgctxt "#1074 desc"
msgid ""
"A fresh potato that's a little on the small side. Tends to\n"
"maintain its shape, making it ideal for boiling."
msgstr ""
"Củ khoai tây tuy có kích thước hơi nhỏ nhưng bên trong mọng nước.\n"
"Do kết cấu khó bị nát khi ninh nấu nên rất phù hợp cho các món hầm."

msgctxt "#1075 name"
msgid "Starberry"
msgstr "Dâu tây ngôi sao"

msgctxt "#1075 desc"
msgid ""
"A small fruit with a star-like shape when cut open. Known for \n"
"its sweet and sour taste."
msgstr ""
"Loại quả mọng cỡ nhỏ có mặt cắt hình ngôi sao năm cánh đặc trưng.\n"
"Mang hương vị chua thanh mát hòa quyện cùng vị ngọt dịu."

msgctxt "#1076 name"
msgid "Acerbic Tomato"
msgstr "Cà chua đắng"

msgctxt "#1076 desc"
msgid ""
"A new kind of tomato native to the Liberl Kingdom. \n"
"Incredibly bitter, and yet strangely addictive."
msgstr ""
"Cà chua có nguồn gốc từ Vương quốc Liberl.\n"
"Mang vị đắng ngắt, nhưng không hiểu sao càng ăn càng cuốn."

msgctxt "#1077 name"
msgid "Honey Syrup"
msgstr "Siro mật ong"

msgctxt "#1077 desc"
msgid ""
"Fragrant honey syrup. Known for being sweet without being too\n"
"rich."
msgstr ""
"Mật ong tự nhiên mang hương thơm thanh mát của hoa rừng.\n"
"Đặc trưng bởi vị ngọt đậm đà nhưng không hề bị gắt cổ."

msgctxt "#1078 name"
msgid "Coarse Rock Salt"
msgstr "Muối biển hạt thô"

msgctxt "#1078 desc"
msgid "Coarsely ground rock salt. Exceptionally salty on the tongue."
msgstr ""
"Loại muối thô được làm từ các khối đá muối tự nhiên.\n"
"Đặt lên đầu lưỡi sẽ cảm nhận được vị mặn bùng nổ."

msgctxt "#1079 name"
msgid "Assorted Grains"
msgstr "Ngũ cốc thập cẩm"

msgctxt "#1079 desc"
msgid ""
"An assortment of popular grains, including rice, wheat and\n"
"beans. Essential for cooking."
msgstr ""
"Ngũ cốc gồm các loại gạo, lúa mạch và đậu.\n"
"Là nguyên liệu không thể thiếu trong các món ăn."

msgctxt "#1080 name"
msgid "Healthy Liquor"
msgstr "Bách Dược Tinh Tửu"

msgctxt "#1080 desc"
msgid ""
"A liquor with a mild taste. Highly nutritious, it is\n"
"particularly prized in cooking."
msgstr ""
"Loại rượu ủ mang lại cảm giác dễ chịu khi uống.\n"
"Rất giàu dinh dưỡng, thường được dùng để làm gia vị trong nấu ăn."

msgctxt "#1081 name"
msgid "Red Beast Flesh"
msgstr "Thịt đỏ ma thú"

msgctxt "#1081 desc"
msgid ""
"Red meat from a monster. Fills you with energy with every\n"
"bite."
msgstr ""
"Khối thịt đỏ chứa đựng sự hoang dã.\n"
"Sức mạnh trào dâng trên từng miếng nhai."

msgctxt "#1082 name"
msgid "White Beast Flesh"
msgstr "Thịt trắng ma thú"

msgctxt "#1082 desc"
msgid ""
"White meat from a monster. Has a tender texture and\n"
"refreshing taste."
msgstr ""
"Khối thịt trắng chứa đựng sự hoang dã.\n"
"Kết cấu săn chắc cùng hương vị thanh đạm."

msgctxt "#1083 name"
msgid "Chitinous Shell"
msgstr "Vỏ ma thú"

msgctxt "#1083 desc"
msgid ""
"A highly nutritious monster's shell. Produces a mellow\n"
"tasting stock when boiled."
msgstr ""
"Lớp vỏ của ma thú được tích nhiều dinh dưỡng bên trong.\n"
"Khi ninh kỹ sẽ chiết xuất ra phần nước vô cùng thơm ngon."

msgctxt "#1084 name"
msgid "Clear Gelatin"
msgstr "Gelatin ma thú"

msgctxt "#1084 desc"
msgid ""
"A wobbly, viscous liquid. Its appearance may leave much to be\n"
"desired, but it melts in the mouth."
msgstr ""
"Một thứ dung dịch nhầy nhụa và núng nính.\n"
"Ngoại hình tuy bất ổn, nhưng tan chảy nơi đầu lưỡi."

msgctxt "#1085 name"
msgid "Globby Fat"
msgstr "Mỡ ma thú"

msgctxt "#1085 desc"
msgid ""
"Thick fat from a monster. Delicious, though it takes some\n"
"getting used to the taste."
msgstr ""
"Loại mỡ béo ngậy và đậm đà.\n"
"Dù mùi vị không được lòng số đông, nhưng đã quen thì chỉ có ghiền."

msgctxt "#1086 name"
msgid "Hearty Powder"
msgstr "Bột ma thú"

msgctxt "#1086 desc"
msgid ""
"Delicate powder that stimulates the tastebuds. Used as a \n"
"spice and as a thickener in cooking."
msgstr ""
"Loại bột mịn mang đến sự kích thích vô cùng khó tả.\n"
"Được sử dụng như một loại gia vị hoặc chất kết dính khi nấu ăn."

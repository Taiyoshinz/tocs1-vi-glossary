msgstr "Băng đô tất thắng"

msgctxt "#345 desc"
msgid ""
"[STR+5/CP Up]\n"
"A motivating headband. CP recovery rate rises in battle."
msgstr ""
"[SM+5/Hồi CP]\n"
"Băng đô chất chứa sự quyết tâm. Tăng tỉ lệ hồi CP trong chiến đấu."

msgctxt "#346 name"
msgid "Gladiator Belt"
msgstr "Thắt lưng Đấu hồn"

msgctxt "#346 desc"
msgid ""
"[STR+5/DEF+5/Auto-CP Up]\n"
"A motivating belt. CP automatically recovers in battle."
msgstr ""
"[SM+5/PT+5/Tự Động Hồi CP]\n"
"Thắt lưng khơi dậy tinh thần chiến đấu. CP tự động hồi trong chiến đấu."

msgctxt "#347 name"
msgid "Swordtail Badge"
msgstr "Huy hiệu Cá Swordy"

msgctxt "#347 desc"
msgid ""
"[HP+100/ACC+25%/SPD+3]\n"
"A badge with a picture of a swordtail on it. Part of a set."
msgstr ""
"[HP+100/CX+25％/TĐ+3]\n"
"Huy hiệu nằm trong bộ sưu tập cá, có in hình của Cá Kiếm."

msgctxt "#348 name"
msgid "Carp Badge"
msgstr "Huy hiệu Cá chép"

msgctxt "#348 desc"
msgid ""
"[HP+250/ACC+50%/DEF+10]\n"
"A badge with a picture of a carp on it. Part of a set."
msgstr ""
"[HP+250/CX+50％/PT+10]\n"
"Huy hiệu nằm trong bộ sưu tập cá, có in hình của Cá Chép."

msgctxt "#349 name"
msgid "Salmon Badge"
msgstr "Huy hiệu Cá hồi"

msgctxt "#349 desc"
msgid ""
"[HP+500/ACC+100%/STR+15]\n"
"A badge with a picture of a salmon on it. Part of a set."
msgstr ""
"[HP+500/CX+100％/SM+15]\n"
"Huy hiệu nằm trong bộ sưu tập cá, có in hình của Cá Hồi."

msgctxt "#350 name"
msgid "Ceramic Ring"
msgstr "Nhẫn gốm sứ"

msgctxt "#350 desc"
msgid ""
"[ATS+3/ADF+3]\n"
"A ring made from ceramic. Pretty but fragile."
msgstr ""
"[PL/PA+3]\n"
"Nhẫn được làm từ gốm sứ, vẻ ngoài đẹp đẽ nhưng rất dễ vỡ."

msgctxt "#351 name"
msgid "ZCF Light"
msgstr "Đèn pin ZCF"

msgctxt "#351 desc"
msgid ""
"[ACC+25%/Prevents Blind]\n"
"A small accessory light made at Zeiss Central Factory."
msgstr ""
"[CX+25%/Kháng Mù Lòa]\n"
"Đèn pin mini dùng làm phụ kiện, xuất xứ từ Xưởng Trung Tâm Zeiss."

msgctxt "#352 name"
msgid "Frog Strap"
msgstr "Móc khóa Kero Kero"

msgctxt "#352 desc"
msgid ""
"[EP+20/SPD+2]\n"
"A strap with a figurine of a frog attached. Part of a set."
msgstr ""
"[EP+20/TĐ+2]\n"
"Móc khóa nằm trong bộ sưu tập, in hình của một chú ếch vô cùng khó tả."

msgctxt "#353 name"
msgid "Puppy Strap"
msgstr "Móc khóa Wan Wan"

msgctxt "#353 desc"
msgid ""
"[HP+200/STR+2]\n"
"A strap with a figurine of a puppy attached. Part of a set."
msgstr ""
"[HP+200/SM+2]\n"
"Móc khóa nằm trong bộ sưu tập, in hình của một chú cún vô cùng khó tả."

msgctxt "#354 name"
msgid "Kitty Strap"
msgstr "Móc khóa Nyan Nyan"

msgctxt "#354 desc"
msgid ""
"[EP+50/ATS+5]\n"
"A strap with a figurine of a kitten attached. Part of a set."
msgstr ""
"[EP+50 PL+5]\n"
"Móc khóa nằm trong bộ sưu tập, in hình của một chú mèo vô cùng khó tả."

msgctxt "#355 name"
msgid "Horseman's Cap"
msgstr "Mũ kỵ sĩ"

msgctxt "#355 desc"
msgid ""
"[STR+4/SPD+2]\n"
"A luxuriously designed cap for refined horse riders."
msgstr ""
"[SM+4/TĐ+2]\n"
"Chiếc mũ dành co kỵ sĩ, được thiết kế vô cùng sang trọng và cao cấp."

msgctxt "#356 name"
msgid "Highland Cloth"
msgstr "Vải Nord"

msgctxt "#356 desc"
msgid ""
"[STR+5/ATS+5]\n"
"Cloth woven in the nomadic settlement. Multipurpose."
msgstr ""
"[SM/PL+5]\n"
"Vải được các bộ lạc tại Nord dệt nên, có thể sử dụng cho nhiều mục đích."

msgctxt "#357 name"
msgid "Silver Hourglass"
msgstr "Đồng hồ cát bạc"

msgctxt "#357 desc"
msgid ""
"[ATS+5/SPD+3]\n"
"A small silver charm. Modeled after an hourglass."
msgstr ""
"[PL+5/TĐ+3]\n"
"Vật hộ mệnh nhỏ nhắn, mang hình dáng của một chiếc đồng hồ cát bằng bạc."

msgctxt "#358 name"
msgid "Golden Hourglass"
msgstr "Đồng hồ cát vàng"

msgctxt "#358 desc"
msgid ""
"[STR+7/SPD+3]\n"
"A small gold charm. Modeled after an hourglass."
msgstr ""
"[SM+7/TĐ+3]\n"
"Vật hộ mệnh nhỏ nhắn, mang hình dáng của một chiếc đồng hồ cát vàng."

msgctxt "#359 name"
msgid "Fairy Brooch"
msgstr "Trâm cài nàng tiên"

msgctxt "#359 desc"
msgid ""
"[ATS+10/ADF+10/SPD+2/Prevents Confuse]\n"
"A charming brooch with a design resembling a fairy's feathers."
msgstr ""
"[PL/PA+10/TĐ+2/Kháng Loạn Trí]\n"
"Trâm cài dễ thương với họa tiết đôi cánh của nàng tiên."

msgctxt "#360 name"
msgid "Fairy Necklace"
msgstr "Vòng cổ nàng tiên"

msgctxt "#360 desc"
msgid ""
"[ATS+10/ADF+10/SPD+2/Prevents Sleep/Nightmare]\n"
"A cute necklace with a design resembling a fairy's feathers."
msgstr ""
"[PL/PA+10/TĐ+2/Kháng Ngủ Mê/Ác Mộng]\n"
"Vòng cổ dễ thương với họa tiết đôi cánh của nàng tiên."

msgctxt "#361 name"
msgid "Mechanic's Goggles"
msgstr "Kính kỹ sư"

msgctxt "#361 desc"
msgid ""
"[EP+100/Prevents Blind]\n"
"Goggles that allow mechanics to focus on their work."
msgstr ""
"[EP+100/Kháng Mù Lòa]\n"
"Kính chuyên dụng dành cho kỹ sư, giúp nâng cao khả năng tập trung."


msgid "Medal of Valor"
msgstr "Huân chương Quả cảm"

msgctxt "#372 desc"
msgid ""
"[STR+25/SPD+5]\n"
"One of the four Lionheart Medals. Given by Instructor Makarov."
msgstr ""
"[SM+25/TĐ+5]\n"
"Huân Chương Trái Tim Sư Tử được trao tặng bởi Giáo Quan Makarov."

msgctxt "#373 name"
msgid "Medal of Friendship"
msgstr "Huân chương Hảo hữu"

msgctxt "#373 desc"
msgid ""
"[HP+1000/DEF+25/ADF+25]\n"
"One of the four Lionheart Medals. Given by Instructor Mary."
msgstr ""
"[HP+1000/PT+25/PA+25]\n"
"Huân Chương Trái Tim Sư Tử được trao tặng bởi Giáo Quan Mary."

msgctxt "#374 name"
msgid "Medal of Compassion"
msgstr "Huân chương Thiện lương"

msgctxt "#374 desc"
msgid ""
"[EP+100/ATS+25]\n"
"One of the four Lionheart Medals. Given by Instructor Beatrix."
msgstr ""
"[EP+100/PL+25]\n"
"Huân Chương Trái Tim Sư Tử được trao tặng bởi Giáo Quan Beatrix."

msgctxt "#375 name"
msgid "Medal of Heroism"
msgstr "Huân chương Anh dũng"

msgctxt "#375 desc"
msgid ""
"[STR+50/ATS+50]\n"
"The most revered Lionheart Medal. Given by Principal Vandyck."

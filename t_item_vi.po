msgctxt "#0 name"
msgid "Tear Balm"
msgstr "Thuốc Tear"

msgctxt "#0 desc"
msgid ""
"[Restores 800 HP]\n"
"A healing salve prepared by the Septian Church."
msgstr ""
"[Hồi phục 800 HP]\n"
"Thuốc hồi phục được điều chế tại Giáo hội Thất Diệu."

msgctxt "#1 name"
msgid "Teara Balm"
msgstr "Thuốc Tearal"

msgctxt "#1 desc"
msgid ""
"[Restores 2500 HP]\n"
"A healing salve prepared by the Septian Church."
msgstr ""
"[Hồi phục 2500 HP]\n"
"Thuốc hồi phục được điều chế tại Giáo hội Thất Diệu."

msgctxt "#2 name"
msgid "Tearal Balm"
msgstr "Thuốc Tearal"

msgctxt "#2 desc"
msgid ""
"[Restores 8000 HP]\n"
"A healing salve prepared by the Septian Church."
msgstr ""
"[Hồi phục 8000 HP]\n"
"Thuốc hồi phục được điều chế tại Giáo hội Thất Diệu."

msgctxt "#3 name"
msgid "EP Charge I"
msgstr "Sạc EP I"

msgctxt "#3 desc"
msgid ""
"[Restores 100 EP]\n"
"A capsule filled with orbal energy."
msgstr ""
"[Hồi phục 100 EP]\n"
"Viên nang chứa năng lượng dẫn lực."

msgctxt "#4 name"
msgid "EP Charge II"
msgstr "Sạc EP II"

msgctxt "#4 desc"
msgid ""
"[Restores 300 EP]\n"
"A capsule filled with orbal energy."
msgstr ""
"[Hồi phục 300 EP]\n"
"Viên nang chứa năng lượng dẫn lực."

msgctxt "#5 name"
msgid "EP Charge III"
msgstr "Sạc EP III"

msgctxt "#5 desc"
msgid ""
"[Restores 500 EP]\n"
"A capsule filled with orbal energy."
msgstr ""
"[Hồi phục 500 EP]\n"
"Viên nang chứa năng lượng dẫn lực."

msgctxt "#6 name"
msgid "Reviving Balm"
msgstr "Thuốc Ceras"

msgctxt "#6 desc"
msgid ""
"[Cures K.O./Restores 1000 HP]\n"
"A salve that cures K.O. and restores 1000 HP."
msgstr ""
"[Giải trừ Gục Ngã/Hồi 100 HP]\n"
"Giải trừ trạng thái Gục Ngã và hồi 1000 HP."

msgctxt "#7 name"
msgid "Celestial Balm"
msgstr "Thuốc Aceras"

msgctxt "#7 desc"
msgid ""
"[Cures K.O./Restores 5000 HP]\n"
"A salve that cures K.O. and restores 5000 HP."
msgstr ""
"[Giải trừ Gục Ngã/Hồi 5000 HP]\n"
"Giải trừ trạng thái Gục Ngã và hồi 5000 HP."

msgctxt "#8 name"
msgid "Celestial Balm EX"
msgstr "Thuốc Aceras Cải Tiến"

msgctxt "#8 desc"
msgid ""
"[Cures K.O./Restores 10,000 HP]\n"
"A salve that cures K.O. and restores 10,000 HP."
msgstr ""
"[Giải trừ Gục Ngã/Hồi 10000 HP]\n"
"Giải trừ trạng thái Gục Ngã và hồi 10000 HP."

msgctxt "#9 name"
msgid "Zeram Powder"
msgstr "Bột Zeram"

msgctxt "#9 desc"
msgid ""
"[Cures K.O./Restores all HP/Restores 100 CP]\n"
"A powder that revives and restores all HP and 100 CP."
msgstr ""
"[Giải trừ Gục Ngã/Hồi đầy HP/Hồi 100 CP]\n"
"Giải trừ trạng thái Gục Ngã, hồi đầy HP và 100 CP."

msgctxt "#10 name"
msgid "Zeram Capsule"
msgstr "Viên Nang Zeram"

msgctxt "#10 desc"
msgid ""
"[Cures K.O./Restores all HP/Restores 200 CP]\n"
"A powder that revives and restores all HP and 200 CP."
msgstr ""
"[Giải trừ Gục Ngã/Hồi đầy HP/Hồi 200 CP]\n"
"Giải trừ trạng thái Gục Ngã, hồi đầy HP và 200 CP."

msgctxt "#11 name"
msgid "Antidote"
msgstr "Thuốc Giải Độc"

msgctxt "#11 desc"
msgid ""
"[Cures Poison]\n"
"A salve from the Septian Church that neutralizes poisons."
msgstr ""
"[Giải trừ Độc]\n"
"Thuốc trung hòa độc tố của Giáo hội Thất Diệu."

msgctxt "#12 name"
msgid "Relaxant"
msgstr "Gel Giãn Cơ"

msgctxt "#12 desc"
msgid ""
"[Cures Seal]\n"
"A gelatinous liquid that cures paralysis of the limbs."
msgstr ""
"[Giải trừ Cấm Kỹ]\n"
"Loại chất lỏng giúp chữa tê bì tay chân."

msgctxt "#13 name"
msgid "Insulating Tape"
msgstr "Băng Cách Dẫn"

msgctxt "#13 desc"
msgid ""
"[Cures Mute]\n"
"Quick-fix tape to repair a neutralized orbment."
msgstr ""
"[Giải trừ Cấm Phép]\n"
"Băng keo sơ cứu, giải trừ nhiễu loạn dẫn lực của thiết bị dẫn lực."

msgctxt "#14 name"
msgid "Eye Drop"
msgstr "Thuốc Nhỏ Mắt"

msgctxt "#14 desc"
msgid ""
"[Cures Blind]\n"
"Eye drops that cure sudden visual impairments."
msgstr ""
"[Giải trừ Mù Lòa]\n"
"Dung dịch thuốc điều trị các tổn thương thị giác đột ngột."

msgctxt "#15 name"
msgid "Mint Drop"
msgstr "Giọt Bạc Hà"

msgctxt "#15 desc"
msgid ""
"[Cures Sleep/Nightmare]\n"
"A mint-flavored candy that cures drowsiness when licked."
msgstr ""
"[Giải trừ Ngủ Mê/Ác Mộng]\n"
"Kẹo ngậm vị bạc hà sảng khoái, thổi bay mọi cơn buồn ngủ."

msgctxt "#16 name"
msgid "Cooling Spray"
msgstr "Bình Xịt Lạnh"

msgctxt "#16 desc"
msgid ""
"[Cures Burn]\n"
"A spray that cools burns rapidly with icy powder."
msgstr ""
"[Giải trừ Thiêu Đốt]\n"
"Bình xịt sử dụng bột lạnh giúp chữa trị vết bỏng một cách nhanh chóng."

msgctxt "#17 name"
msgid "Warmer"
msgstr "Túi Sưởi Giải Đông"

msgctxt "#17 desc"
msgid ""
"[Cures Freeze]\n"
"A disposable packet that warms the whole body."
msgstr ""
"[Giải trừ Đóng Băng]\n"
"Túi sưởi giúp làm ấm cơ thể từ trong ra ngoài."

msgctxt "#18 name"
msgid "Softening Ointment"
msgstr "Dung Dịch Làm Mềm"

msgctxt "#18 desc"
msgid ""
"[Cures Petrify]\n"
"An ointment that softens petrified parts of the body."
msgstr ""
"[Giải trừ Hóa Đá]\n"
"Thuốc mỡ dạng lỏng, bôi lên phục hồi chỗ cơ thể bị hóa đá."

msgctxt "#19 name"
msgid "Stimulant"
msgstr "Thuốc Đánh Thức"

msgctxt "#19 desc"
msgid ""
"[Cures Faint]\n"
"A salve from the Septian Church that restores consciousness."
msgstr ""
"[Giải trừ Ngất]\n"
"Loại thuốc bí truyền của Giáo hội Thất Diệu giúp lấy lại ý thức."

msgctxt "#20 name"
msgid "Sedative"
msgstr "Thuốc An Thần"

msgctxt "#20 desc"
msgid ""
"[Cures Confuse]\n"
"A salve from the Septian Church that restores mental alertness."
msgstr ""
"[Giải trừ Loạn Trí]\n"
"Loại thuốc bí truyền của Giáo hội Thất Diệu giúp bình ổn tinh thần."

msgctxt "#21 name"
msgid "S-Tablet"
msgstr "Viên Nén S"

msgctxt "#21 desc"
msgid ""
"[Cures Stat Down]\n"
"A pill that returns lowered attributes to their normal levels."
msgstr ""
"[Giải trừ Suy Yếu ]\n"
"Viên nén giúp hồi phục các chỉ số năng lực bị suy yếu."

msgctxt "#22 name"
msgid "Curia Balm"
msgstr "Thuốc Curia"

msgctxt "#22 desc"
msgid ""
"[Cures Abnormal Status]\n"
"A salve that cures all status abnormalities except K.O."
msgstr ""
"[Giải trừ Trạng Thái Dị Thường]\n"
"Thuốc giúp giải trừ mọi Trạng Thái Dị Thường ngoại trừ Gục Ngã."

msgctxt "#23 name"
msgid "Smoke Grenade"
msgstr "Bóng Nhả Khói"

msgctxt "#23 desc"
msgid ""
"[100% success fleeing battle]\n"
"Used to escape from battle. (Can't be used in certain battles)"
msgstr ""
"[100% thành công Thoái Lui]\n"
"Ngay lập tức tẩu thoát khỏi trận chiến (trừ một số trận chiến)."

msgctxt "#24 name"
msgid "Battle Scope"
msgstr "Ống Ngắm Chiến Trận"

msgctxt "#24 desc"
msgid ""
"[Analysis]\n"
"Analyzes an enemy's key data."
msgstr ""
"[Phân Tích]\n"
"Phân tích thông tin của kẻ địch."

msgctxt "#25 name"
msgid "Shining Pom Bait"
msgstr "Mồi Nhử Pom Lấp Lánh"

msgctxt "#25 desc"
msgid "Bait to lure out a rare and elusive Shining Pom."
msgstr "Mồi dùng để dụ lũ Pom lấp lánh tròn ủm."

msgctxt "#26 name"
msgid "Vanilla Gelato"
msgstr "Gelato vani"

msgctxt "#26 desc"
msgid ""
"[Restores 2800 HP/Cures Burn]\n"
"A creamy gelato made with generous amounts of milk."
msgstr ""
"[Hồi phục 2800 HP/Giải trừ Thiêu Đốt]\n"
"Kem Gelato béo ngậy được làm từ lượng sữa dồi dào."

msgctxt "#27 name"
msgid "Lemon Gelato"
msgstr "Gelato chanh"

msgctxt "#27 desc"
msgid ""
"[Restores 1000 HP/Restores 150 EP]\n"
"A refreshing gelato with just the right amount of tartness."
msgstr ""
"[Hồi phục 1000 HP/Hồi phục 150 EP]\n"
"Kem Gelato chua thanh khó cưỡng, cảm giác sảng khoái."

msgctxt "#28 name"
msgid "Tetra Gelato"
msgstr "Kem bốn vị"

msgctxt "#28 desc"
msgid ""
"[Restores 700 HP/STR/DEF/ATS/ADF+25% (4 Turns)]\n"
"A special gelato with swirls of four different flavors."
msgstr ""
"[Hồi phục 700 HP và SM/PT/PL/PA +25% (4 lượt)]\n"
"Kem Gelato đặc chế được hòa trộn từ 4 loại kem khác nhau."

msgctxt "#29 name"
msgid "Ground Sausage"
msgstr "Xúc xích bằm thô"

msgctxt "#29 desc"
msgid ""
"[Restores 4200 HP/Cures Seal]\n"
"An extra thick, savory sausage."
msgstr ""
"[Hồi phục 4200 HP / Giải trừ Cấm Kỹ]\n"
"Xúc xích dày và bự chảng, trọn vẹn vị ngọt của thịt."

msgctxt "#30 name"
msgid "Turkey Leg"
msgstr "Chân gà lôi"

msgctxt "#30 desc"
msgid ""
"[Restores 4200 HP/Cures Mute]\n"
"A tender, juicy turkey leg, still on the bone."
msgstr ""
"[Hồi phục 4200 HP / Giải trừ Cấm Phép]\n"
"Khối thịt liền xương mềm mại và mọng nước."

msgctxt "#31 name"
msgid "Chocobanana Crepe"
msgstr "Bánh kếp chuối sôcôla"

msgctxt "#31 desc"
msgid ""
"[Restores 4000 HP]\n"
"A banana crepe drizzled with chocolate. Incredibly sweet."
msgstr ""
"[Hồi phục 4000 HP]\n"
"Bánh kếp chuối phủ thêm sô-cô-la bên trên. Ngọt đến tận cùng."

msgctxt "#32 name"
msgid "Banana Crepe"
msgstr "Bánh kếp chuối"

msgctxt "#32 desc"
msgid ""
"[Restores 3200 HP]\n"
"A standard crepe made with bananas and fresh cream."
msgstr ""
"[Hồi phục 3200 HP]\n"
"Bánh kếp thông thường với sự kết hợp giữa chuối và kem tươi."

msgctxt "#33 name"
msgid "Apple Juice"
msgstr "Nước táo"

msgctxt "#33 desc"
msgid ""
"[Restores 1000 HP/Restores 50 EP]\n"
"100% pure apple juice."
msgstr ""
"[Hồi phục 1000 HP / Hồi phục 50 EP]\n"
"100% nguyên chất từ những quả táo trĩu mật ngọt."

msgctxt "#34 name"
msgid "Orange Juice"
msgstr "Nước cam"

msgctxt "#34 desc"
msgid ""
"[Restores 1000 HP/Restores 20 CP]\n"
"Pure orange juice squeezed from premium, ripe oranges."
msgstr ""
"[Hồi phục 1000 HP / Tăng 20 CP]\n"
"100% nguyên chất từ cam chín cây, chế biến bằng cả tâm huyết."

msgctxt "#35 name"
msgid "Steak Skewer"
msgstr "Xiên thịt mười miếng"

msgctxt "#35 desc"
msgid ""
"[Restores 4800 HP/STR+25% (3 Turns)]\n"
"Specially prepared by Becky without any regard for profit."
msgstr ""
"[Hồi phục 4800 HP, SM+25%]\n"
"Thực đơn đặc biệt của Becky, làm ra không nhằm kiếm lợi nhuận."

msgctxt "#36 name"
msgid "Rich Strawberry Crepe"
msgstr "Bánh kếp đầy ắp dâu tây"

msgctxt "#36 desc"
msgid ""
"[Restores 6000 HP]\n"
"Decadent crepes masterfully prepared by Hugo."
msgstr ""
"[Hồi phục 6000 HP]\n"
"Bánh kếp đầy nhân do Hugo sáng chế, mang lại cảm giác xa hoa."

msgctxt "#37 name"
msgid "Dark Cherry Pie"
msgstr "Bánh anh đào đen"

msgctxt "#37 desc"
msgid ""
"[Restores 2000 HP/Restores 200 EP]\n"
"A new kind of pie made using flavorful dark cherries."
msgstr ""
"[Hồi phục 2000 HP, Hồi phục 200 EP]\n"
"Bánh nướng kiểu mới sử dụng quả anh đào đen đậm đà hương vị."

msgctxt "#38 name"
msgid "U-Material"
msgstr "Vật Chất U"

msgctxt "#38 desc"
msgid ""
"An unknown material that is impossible to analyze.\n"
"Can be used to customize equipment at an orbal factory."
msgstr ""
"Vật chất chưa xác định không thể phân tích.\n"
"Mang đến công xưởng có thể dùng làm vật liệu cải tiến vũ khí."

msgctxt "#39 name"
msgid "Zemurian Ore Shard"
msgstr "Mảnh Đá Zemuria"

msgctxt "#39 desc"
msgid ""
"An ore fragment that glistens like the stars in the night sky.\n"
"They can be combined to form a full chunk of Zemurian Ore."
msgstr ""
"Mảnh khoáng thạch tỏa ánh lấp lánh như vì sao.\n"
"Gom đủ vài mảnh sẽ có giá trị cỡ 1 viên Đá Zemuria."

msgctxt "#40 name"
msgid "Zemurian Ore"
msgstr "Đá Zemuria"

msgctxt "#40 desc"
msgid ""
"A lump of ore that glistens like the stars in the night sky.\n"
"Its hardness makes it extremely difficult to work with."
msgstr ""
"Khối khoáng thạch tỏa ánh lấp lánh như vô số vì sao.\n"
"Khá cứng nên việc gia công rất khó khăn."

msgctxt "#41 name"
msgid "Orbal Scale"
msgstr "Cân đo dẫn lực"

msgctxt "#41 desc"
msgid ""
"Entrusted to you by George. It needs to be delivered to \n"
"Nicholas of the Cooking Club."
msgstr ""
"Món đồ nhận từ tiền bối George.\n"
"Cần giao nó cho trưởng câu lạc bộ nấu ăn Nicolas."

msgctxt "#42 name"
msgid "Antique Orbal Lamp"
msgstr "Đèn dẫn lực kiểu cổ"

msgctxt "#42 desc"
msgid ""
"Entrusted to you by George. It needs to be delivered to\n"
"Micht at the pawn shop."
msgstr ""
"Món đồ nhận từ tiền bối George.\n"
"Cần giao nó cho tiệm cầm đồ \"Micht\"."

msgctxt "#43 name"
msgid "Orbal Wristwatch"
msgstr "Đồng hồ đeo tay dẫn lực"

msgctxt "#43 desc"
msgid ""
"Entrusted to you by George. It needs to be delivered to \n"
"Michael at Radio Trista."
msgstr ""
"Món đồ nhận từ tiền bối George.\n"
"Cần giao nó cho anh Michael ở \"Đài phát thanh Trista\"."

msgctxt "#44 name"
msgid "Colette's Student Notebook"
msgstr "Sổ Tay Học Viên của Colette"

msgctxt "#44 desc"
msgid ""
"Colette's student notebook. Found on the second floor\n"
"of the main building."
msgstr ""
"Sổ tay học viên mà Colette đánh rơi.\n"
"Được tìm thấy ở tầng 2 của tòa nhà chính."

msgctxt "#45 name"
msgid "Passion Leaf Bundle"
msgstr "Bó Lá Nhiệt Tình"

msgctxt "#45 desc"
msgid ""
"A rare kind of seasoning native to the southern part of the\n"
"continent. Has a unique flavor that's quite addictive."
msgstr ""
"Gia vị quý hiếm có nguồn gốc từ phía Nam lục địa.\n"
"Hương vị độc đáo dễ gây nghiện."

msgctxt "#46 name"
msgid "New Orbment Light"
msgstr "Đèn dẫn lực mới"

msgctxt "#46 desc"
msgid ""
"A replacement orbment light, entrusted to you by Samus.\n"
"Glows brightly."
msgstr ""
"Đèn dẫn lực dùng để thay thế nhận từ Samus.\n"
"Nó đang tỏa sáng lấp lánh."

msgctxt "#47 name"
msgid "Broken Orbment Light"
msgstr "Đèn dẫn lực hỏng"

msgctxt "#47 desc"
msgid ""
"A broken orbment light, recovered from a road lamp on the\n"
"highway."
msgstr "Đèn dẫn lực bị hỏng được thu hồi từ cột đèn đường đã tắt sáng."

msgctxt "#48 name"
msgid "Bear Claw"
msgstr "Vuốt Gấu"

msgctxt "#48 desc"
msgid ""
"A thorny medicinal herb that looks like a bear's claw.\n"
"Sometimes used in cooking."
msgstr ""
"Loại thảo dược có gai sắc như móng vuốt gấu.\n"
"Cũng được sử dụng trong nấu ăn như một loại hương thảo."

msgctxt "#49 name"
msgid "Imperial Carrots"
msgstr "Cà Rốt Hoàng Đế"

msgctxt "#49 desc"
msgid ""
"Highly nutritious bright red carrots. A rare ingredient\n"
"sometimes given as a gift to the Imperial family."
msgstr ""
"Củ cà rốt đỏ rực vô cùng bổ dưỡng.\n"
"Là giống cây quý hiếm thi thoảng được dâng lên hoàng gia."

msgctxt "#50 name"
msgid "Lost Wallet"
msgstr "Ví bị đánh rơi"

msgctxt "#50 desc"
msgid "Someone's wallet, entrusted to you by Lizzie."
msgstr "Chiếc ví đánh rơi nhận được từ Lizzie. Nên tìm trả khổ chủ."

msgctxt "#51 name"
msgid "Behind the War of the Lions"
msgstr "Vén màn Chiến dịch Sư Tử"

msgctxt "#51 desc"
msgid ""
"A book ordered by an instructor. Keynes asked you to deliver\n"
"it."
msgstr ""
"Cuốn sách dành cho giáo quan được\n"
"nhà sách Keynes nhờ giao hàng giúp."

msgctxt "#52 name"
msgid "Modern Art: The Complete Works"
msgstr "Mỹ thuật Cận đại toàn tập"

msgctxt "#52 desc"
msgid ""
"A book ordered by an instructor. Keynes asked you to deliver\n"
"it."
msgstr ""
"Cuốn sách dành cho giáo quan được\n"
"nhà sách Keynes nhờ giao hàng giúp."

msgctxt "#53 name"
msgid "Topical Science"
msgstr "Khoa học tân giải"

msgctxt "#53 desc"
msgid ""
"A book ordered by an instructor. Keynes asked you to deliver\n"
"it."
msgstr ""
"Cuốn sách dành cho giáo quan được\n"
"nhà sách Keynes nhờ giao hàng giúp."

msgctxt "#54 name"
msgid "Analyzing Macroeconomics"
msgstr "Phân tích: Kinh tế vĩ mô"

msgctxt "#54 desc"
msgid ""
"A book ordered by an instructor. Keynes asked you to deliver\n"
"it."
msgstr ""
"Cuốn sách dành cho giáo quan được\n"
"nhà sách Keynes nhờ giao hàng giúp."

msgctxt "#55 name"
msgid "The Empire's Hottest Spots"
msgstr "Ồ, Tuyến du lịch Đế Quốc"

msgctxt "#55 desc"
msgid ""
"A book ordered by an instructor. Keynes asked you to deliver\n"
"it."
msgstr ""
"Cuốn sách dành cho giáo quan được\n"
"nhà sách Keynes nhờ giao hàng giúp."

msgctxt "#56 name"
msgid "Grand Rose Money"
msgstr "Tiền Mua Hoa"

msgctxt "#56 desc"
msgid "Money to buy a grand rose. Received from Linde."
msgstr "Số tiền nhận từ Linde dùng để mua hoa Đại Tường Vi."

msgctxt "#57 name"
msgid "Snow Lilies"
msgstr "Huệ Tuyết"

msgctxt "#57 desc"
msgid ""
"Fresh flowers received from Jane's florist. They need to be\n"
"given to Linde."
msgstr ""
"Hoa tươi dùng để làm mẫu phác họa nhận tại\n"
"tiệm hoa \"Jane\". Hãy mang giao cho Linde."

msgctxt "#58 name"
msgid "Grand Rose"
msgstr "Đại Tường Vi"

msgctxt "#58 desc"
msgid ""
"A fresh flower bought from Jane's florist. It needs to be\n"
"given to Linde."
msgstr ""
"Hoa tươi mua thêm tại tiệm hoa \"Jane\".\n"
"Hãy mang giao cho Linde."

msgctxt "#59 name"
msgid "Dryad's Tear"
msgstr "Nước Mắt Dryad"

msgctxt "#59 desc"
msgid ""
"A lump of resin obtained from the North Kreuzen Highway.\n"
"Can be processed into a jewel as radiant as septium."
msgstr ""
"Khối nhựa cây hái từ cây cối trên xa lộ Bắc Kreuzen. Qua gia\n"
"công sẽ phát ra ánh sáng rực rỡ không kém gì đá quý."

msgctxt "#60 name"
msgid "Pink Salt"
msgstr "Muối Hồng"

msgctxt "#60 desc"
msgid "Natural rock salt from the Aurochs Canyon Path."
msgstr "Muối đá tự nhiên được thu thập ở hẻm núi Aurochs."

msgctxt "#61 name"
msgid "Healing Herb"
msgstr "Thảo Dược Chữa Trị"

msgctxt "#61 desc"
msgid "A medicinal herb given to you by Sister Tatiana."
msgstr "Thảo dược được sơ Tatiana nhượng lại cho."

msgctxt "#62 name"
msgid "Munk's Sticker"
msgstr "Nhãn dán của Munk"

msgctxt "#62 desc"
msgid "A circular sticker dropped by Munk."
msgstr "Chiếc nhãn dán hình tròn mà Munk đánh rơi."

msgctxt "#63 name"
msgid "Epona Grass"
msgstr "Cỏ Epona"

msgctxt "#63 desc"
msgid ""
"A medicinal herb with yellow flowers found in the south part\n"
"of the Nord Highlands. Used to make a medicine for horses."
msgstr ""
"Thảo dược có hoa vàng phân bố ở Nam Cao nguyên Nord.\n"
"Nguyên liệu chế thuốc phòng bệnh đặc hữu cho ngựa ở Nord."

msgctxt "#64 name"
msgid "Food Parcel"
msgstr "Hộp thực phẩm tổng hợp"

msgctxt "#64 desc"
msgid ""
"A food parcel from Kilte for the soldiers at the watchtower.\n"
"Needs to be delivered to a soldier called Zats."
msgstr ""
"Đồ cấp dưỡng gửi đến tháp canh nhận từ Kilte.\n"
"Cần giao nó cho Zats."

msgctxt "#65 name"
msgid "Erebonian Wine"
msgstr "Rượu Vang Đế Quốc"

msgctxt "#65 desc"
msgid ""
"A token of thanks from Zats. It needs to be delivered to\n"
"Kilte."
msgstr "Món đồ đáp lễ nhận từ Zats. Cần giao nó cho Kilte."

msgctxt "#66 name"
msgid "Eastern Ink Brush"
msgstr "Bút kiểu phương Đông"

msgctxt "#66 desc"
msgid ""
"A well-worn Eastern ink brush. Needs to be returned to its\n"
"owner."
msgstr ""
"Chiếc bút lông phong cách phương Đông có vẻ đã được\n"
"dùng rất nhiều. Nên tìm chủ nhân của nó."

msgctxt "#67 name"
msgid "Handmade Summer Cap"
msgstr "Mũ mùa hè thủ công"

msgctxt "#67 desc"
msgid ""
"A handmade cap dropped by a resident of the Ost District.\n"
"It's light and cool."
msgstr ""
"Chiếc mũ lưỡi trai thủ công có vẻ do một cư dân ở quận\n"
"Ost đánh rơi. Được làm rất nhẹ và mát mẻ."

msgctxt "#68 name"
msgid "Orbal Camera"
msgstr "Máy ảnh orbal"

msgctxt "#68 desc"
msgid ""
"An orbal camera received from Norton. Used for his work as a\n"
"journalist."
msgstr "Máy ảnh dẫn lực dùng để tác nghiệp được Norton giao phó."

msgctxt "#69 name"
msgid "PR Comment"
msgstr "Lời PR ngắn"

msgctxt "#69 desc"
msgid "A comment from a store on Vainqueur Street for a pamphlet."
msgstr "Lời PR ngắn dành cho tờ rơi thu thập được từ nơi lấy tin."

msgctxt "#70 name"
msgid "Record Money"
msgstr "Tiền Mua Đĩa Than"

msgctxt "#70 desc"
msgid "Money to buy a record. Received from Heming."
msgstr "Số tiền mua đĩa than được Heming giao phó."

msgctxt "#71 name"
msgid "Amber Amour"
msgstr "Tình Yêu Hổ Phách"

msgctxt "#71 desc"
msgid "An antique record found at a used goods shop."
msgstr "Chiếc đĩa than cổ điển tìm thấy ở cửa hàng đồ cũ."

msgctxt "#72 name"
msgid "Ladies' Stregas"
msgstr "Giày Strega Lady"

msgctxt "#72 desc"
msgid ""
"[DEF+120/MOV+3/STR+15/ACC+20%/Laura Only]\n"
"A new model of Stregas. Received from Howard."
msgstr ""
"[PT+120/DC+3/SM+15/CX +20%. Dành cho Laura]\n"
"Mẫu giày mới nhận từ Howard Owner."

msgctxt "#73 name"
msgid "Orbal Pedometer"
msgstr "Máy đếm bước dẫn lực"

msgctxt "#73 desc"
msgid ""
"An orbal pedometer set to be used with a new pair of shoes.\n"
"Using it allows you to check how many steps you have taken."
msgstr ""
"Máy đếm sử dụng năng lượng dẫn lực được thiết lập trên mẫu\n"
"giày mới. Khi dùng có thể kiểm tra số bước chân hiện tại."

msgctxt "#74 name"
msgid "Phantom Thief B's Card"
msgstr "Thẻ của Đạo Chích B"

msgctxt "#74 desc"
msgid ""
"A card left by Phantom Thief B. Received from Cordelia, the\n"
"shop's owner."
msgstr ""
"Tấm thẻ do tên trộm B để lại.\n"
"Nhận từ cửa hàng trưởng Cordelia."

msgctxt "#75 name"
msgid "Phantom Thief B's Card"
msgstr "Thẻ của Đạo Chích B"

msgctxt "#75 desc"
msgid "A card left by Phantom Thief B. Found at Dreichels Plaza."
msgstr ""
"Tấm thẻ do tên trộm B để lại.\n"
"Tìm thấy ở quảng trường Dreichels."

msgctxt "#76 name"
msgid "Phantom Thief B's Card"
msgstr "Thẻ của Đạo Chích B"

msgctxt "#76 desc"
msgid "A card left by Phantom Thief B. Found in the Crystal Garden."
msgstr ""
"Tấm thẻ do tên trộm B để lại.\n"
"Tìm thấy ở Crystal Garden."

msgctxt "#77 name"
msgid "Phantom Thief B's Card"
msgstr "Thẻ của Đạo Chích B"

msgctxt "#77 desc"
msgid ""
"A card left by Phantom Thief B. Found in the former guild\n"
"branch."
msgstr "Tấm thẻ do tên trộm B để lại. Tìm thấy ở chi nhánh hiệp hội cũ."

msgctxt "#78 name"
msgid "Phantom Thief B's Card"
msgstr "Thẻ của Đạo Chích B"

msgctxt "#78 desc"
msgid "A card left by Phantom Thief B. Found at Heimdallr Port."
msgstr "Tấm thẻ do tên trộm B để lại. Tìm thấy ở Cảng Heimdallr."

msgctxt "#79 name"
msgid "Crimson Tiara"
msgstr "Tiểu Miện Hồng Liên"

msgctxt "#79 desc"
msgid "Unobtainable item."
msgstr "Đây là vật phẩm tạm."

msgctxt "#80 name"
msgid "Maintenance Key"
msgstr "Chìa khóa bảo trì"

msgctxt "#80 desc"
msgid ""
"A key, entrusted to you by Duncan. It's required to open the\n"
"service panel on road lamps."
msgstr ""
"Chìa khóa được Duncan giao phó. Dùng để mở bảng bảo trì\n"
"của cột đèn đường."

msgctxt "#81 name"
msgid "New Orbment Light"
msgstr "Đèn dẫn lực mới"

msgctxt "#81 desc"
msgid ""
"A replacement orbment light, entrusted to you by Duncan.\n"
"Glows brightly."
msgstr "Đèn dẫn lực dùng để thay thế nhận từ Duncan. Nó tỏa sáng lấp lánh."

msgctxt "#82 name"
msgid "Broken Orbment Light"
msgstr "Đèn dẫn lực hỏng"

msgctxt "#82 desc"
msgid ""
"A broken orbment light, recovered from a road lamp on the\n"
"highway."
msgstr "Đèn dẫn lực bị hỏng được thu hồi từ cột đèn đường đã tắt sáng."

msgctxt "#83 name"
msgid "White Seed"
msgstr "Hạt Giống Trắng"

msgctxt "#83 desc"
msgid ""
"A grain crop with pure white seeds. Often found in the Legram\n"
"area."
msgstr ""
"Một loại ngũ cốc thơm ngon với hạt màu trắng tinh,\n"
"thường được trồng ở vùng Legram."

msgctxt "#84 name"
msgid "Legram Pretzel"
msgstr "Bánh Pretzel Legram"

msgctxt "#84 desc"
msgid ""
"A pretzel baked by Sister Theramis. Its unique shape is based\n"
"on the monument in the center of Legram."
msgstr ""
"Bánh quy xoắn do sơ Seramis nướng. Hình dáng độc đáo\n"
"của nó mô phỏng theo bia đá tinh linh ở trung tâm thị trấn."

msgctxt "#85 name"
msgid "Gold Salmon"
msgstr "Cá Hồi Vàng"

msgctxt "#85 desc"
msgid "Unobtainable item."
msgstr "Đây là vật phẩm tạm."

msgctxt "#86 name"
msgid "Luminous Grass"
msgstr "Cỏ Phát Quang"

msgctxt "#86 desc"
msgid ""
"A rare type of flower that blooms only immediately after \n"
"the fog disappears in Legram."
msgstr "Loài hoa quý hiếm chỉ nở rộ ngay sau khi sương mù vừa tan."

msgctxt "#87 name"
msgid "Linium"
msgstr "Quặng Linium"

msgctxt "#87 desc"
msgid ""
"A rare metal found in a mine shaft. It had been consumed by\n"
"a giant monster."
msgstr ""
"Kim loại hiếm thu được trong hầm mỏ.\n"
"Nó đã bị một con ma thú khổng lồ nuốt chửng."

msgctxt "#88 name"
msgid "Orbal Wave Detector"
msgstr "Máy đo sóng dẫn lực"

msgctxt "#88 desc"
msgid ""
"A device to measure orbal waves used by ARCUS orbments. \n"
"Needs to be used in various places, primarily indoors."
msgstr ""
"Thiết bị dùng để đo sóng dẫn lực chuyên dụng của ARCUS.\n"
"Sử dụng nó chủ yếu trong nhà."

msgctxt "#89 name"
msgid "Blade Deck"
msgstr "Bộ bài Blade"

msgctxt "#89 desc"
msgid ""
"A card game, given by Micht. Ideal for playing on long train\n"
"journeys."
msgstr ""
"Trò thẻ bài nhận từ Micht. Dùng để giải trí trong những chuyến đi dài."

msgctxt "#90 name"
msgid "Permission Slip (Nicholas)"
msgstr "Giấy phép Kinh doanh ẩm thực (Nicolas)"

msgctxt "#90 desc"
msgid ""
"A piece of paper that grants the student who owns it\n"
"permission to sell food and drink at the academy festival."
msgstr "Giấy phép để tiến hành kinh doanh ăn uống tại lễ hội Học viện."

msgctxt "#91 name"
msgid "Permission Slip (Colette)"
msgstr "Giấy phép Kinh doanh ẩm thực (Colette)"

msgctxt "#91 desc"
msgid ""
"A piece of paper that grants the student who owns it\n"
"permission to sell food and drink at the academy festival."
msgstr "Giấy phép để tiến hành kinh doanh ăn uống tại lễ hội Học viện."

msgctxt "#92 name"
msgid "Permission Slip (Hugo)"
msgstr "Giấy phép Kinh doanh ẩm thực (Hugo)"

msgctxt "#92 desc"
msgid ""
"A piece of paper that grants the student who owns it\n"
"permission to sell food and drink at the academy festival."
msgstr "Giấy phép để tiến hành kinh doanh ăn uống tại lễ hội Học viện."

msgctxt "#93 name"
msgid "Permission Slip (Becky)"
msgstr "Giấy phép Kinh doanh ẩm thực (Becky)"

msgctxt "#93 desc"
msgid ""
"A piece of paper that grants the student who owns it\n"
"permission to sell food and drink at the academy festival."
msgstr "Giấy phép để tiến hành kinh doanh ăn uống tại lễ hội Học viện."

msgctxt "#94 name"
msgid "Black Leather Notebook"
msgstr "Sổ tay da thuộc đen"

msgctxt "#94 desc"
msgid ""
"A black, leather-bound notebook dropped by Vice Principal\n"
"Heinrich. Needs to be returned to him."
msgstr ""
"Cuốn sổ tay bìa da màu đen mà hiệu phó Heinrich đánh rơi.\n"
"Nên mang trả lại cho thầy hiệu phó."

msgctxt "#95 name"
msgid "Mishy Plush"
msgstr "Thú nhồi bông Mishy"

msgctxt "#95 desc"
msgid "A plush of Mishy. Won at the Mishy Panic attraction."
msgstr "Thú nhồi bông Mishy nhận được từ trò chơi \"Mishy Panic\"."

msgctxt "#96 name"
msgid "Relief Card"
msgstr "Thẻ mạ nổi"

msgctxt "#96 desc"
msgid ""
"Proof that its owner has defeated the Blade Master at Gate of\n"
"Avalon. Has a relief on its surface."
msgstr ""
"Minh chứng cho việc đã đánh bại Blade Master tại\n"
"\"Gate of Avalon\". Vô cùng sang trọng với các chi tiết chạm nổi."

msgctxt "#97 name"
msgid "Super Stallion Shield"
msgstr "Khiên lưu niệm Cúp Mach"

msgctxt "#97 desc"
msgid ""
"An award given to those who cleared Super Stallion in a set\n"
"time. Lambert's beloved horse Whitcomb is carved onto it."
msgstr ""
"Minh chứng hoàn thành đúng hạn tại Mach Stallion,\n"
"khắc hình chú ngựa Mach yêu quý của Lambert."

msgctxt "#98 name"
msgid "Orbal Radio"
msgstr "Radio Dẫn Lực"

msgctxt "#98 desc"
msgid "An orbal radio received from George."
msgstr "Radio dẫn lực nhận được từ tiền bối Geroge."

msgctxt "#99 name"
msgid "Old Schoolhouse Key"
msgstr "Chìa khóa Học xá cũ"

msgctxt "#99 desc"
msgid ""
"The key to the old schoolhouse. Received from Principal\n"
"Vandyck."
msgstr "Chìa khóa dẫn đến khu Học Xá Cũ, nhận được từ hiệu trưởng Vandyck."

msgctxt "#100 name"
msgid "Nord Highlands Map"
msgstr "Bản đồ Cao nguyên Nord"

msgctxt "#100 desc"
msgid ""
"A map of the Nord Highlands, received from Lieutenant General\n"
"Zechs."
msgstr "Bản đồ Cao nguyên Nord, nhận được từ trung tướng Zechs."

msgctxt "#101 name"
msgid "Student Notebook"
msgstr "Sổ tay Học viên"

msgctxt "#101 desc"
msgid ""
"A notebook issued to all members of Thors Military Academy,\n"
"containing the school rules. Also serves as a form of ID."
msgstr ""
"Sổ tay ghi lại các luật lệ của Học viện Sĩ quan Thors.\n"
"Đồng thời đóng vai trò là thẻ nhận dạng của học viên."

msgctxt "#102 name"
msgid "Recipe Book"
msgstr "Sổ tay nấu ăn"

msgctxt "#102 desc"
msgid ""
"A notebook to record various recipes. You can cook food from\n"
"the NOTE menu."
msgstr "Sổ tay ghi lại các công thức nấu ăn. Có thể nấu ăn tại NOTE menu."

msgctxt "#103 name"
msgid "Fishing Book"
msgstr "Sổ tay câu cá"

msgctxt "#103 desc"
msgid "A notebook to record details of the fish you have caught."
msgstr "Sổ tay ghi lại thông tin về các loài cá đã câu được."

msgctxt "#104 name"
msgid "Memory Quartz"
msgstr "Quartz Ký Ức"

msgctxt "#104 desc"
msgid ""
"A memory quartz received from Towa. Contains a video of a \n"
"concert held last year."
msgstr ""
"Quartz ký ức nhận được từ hội trưởng Towa.\n"
"Nó ghi lại tiết mục biểu diễn năm ngoái."

msgctxt "#105 name"
msgid "Address & Keys"
msgstr "Địa chỉ & Chìa khóa"

msgctxt "#105 desc"
msgid ""
"A memo with an address written on it, along with a key,\n"
"received from Governor Regnitz."
msgstr "Mẩu giấy ghi địa chỉ và chìa khóa nhận được từ thống đốc Regnitz."

msgctxt "#106 name"
msgid "Underground Passage Key"
msgstr "Chìa khóa Đường ngầm Đế Đô"

msgctxt "#106 desc"
msgid ""
"The key to enter an underground passage under Heimdallr, \n"
"received from Noble."
msgstr ""
"Chìa khóa dẫn đến các đường hầm ngầm bên dưới Đế Đô,\n"
"nhận được từ quản lý Noble."

msgctxt "#107 name"
msgid "Underground Waterway Key"
msgstr "Chìa khóa Đường nước ngầm Đế Đô"

msgctxt "#107 desc"
msgid ""
"The key to enter an underground waterway under Heimdallr,\n"
"received from Port Chief Danberto."
msgstr ""
"Chìa khóa dẫn đến đường nước ngầm bên dưới Đế Đô,\n"
"nhận được từ quản đốc Danberto."

msgctxt "#108 name"
msgid "Abend Time Sticker"
msgstr "Nhãn dán Abend Time"

msgctxt "#108 desc"
msgid ""
"A sticker sent by Abend Time. Has the serial number '120'\n"
"written on it."
msgstr ""
"Nhãn dán được gửi từ Abend Time.\n"
"Số sê-ri [120] được viết lên nó."

msgctxt "#109 name"
msgid "Yellow Orb"
msgstr "Bảo Châu Vàng"

msgctxt "#109 desc"
msgid ""
"An orb obtained within Lohengrin Castle. Can be used to\n"
"disable the barrier that corresponds with it."
msgstr ""
"Bảo Châu thu thập từ Lâu đài Lohengrin.\n"
"Có thể dùng để phá bỏ kết giới tương ứng."

msgctxt "#110 name"
msgid "Red Orb"
msgstr "Bảo Châu Đỏ"

msgctxt "#110 desc"
msgid ""
"An orb obtained within Lohengrin Castle. Can be used to\n"
"disable the barrier that corresponds with it."
msgstr ""
"Bảo Châu thu thập từ Lâu đài Lohengrin.\n"
"Có thể dùng để phá bỏ kết giới tương ứng."

msgctxt "#111 name"
msgid "Mine Shaft Key"
msgstr "Chìa khóa Hầm mỏ"

msgctxt "#111 desc"
msgid ""
"A key received from Mine Chief Rudolf. Can be used to\n"
"enter a sealed-off mine shaft."
msgstr ""
"Chìa khóa hầm mỏ nhận được từ trưởng mỏ Rudolf.\n"
"Có thể dùng nó để tiến vào khu vực bị phong tỏa."

msgctxt "#112 name"
msgid "Card Key"
msgstr "Thẻ từ"

msgctxt "#112 desc"
msgid ""
"A card key which opens the door leading to a passage between \n"
"the upper level of Roer City and the iron mine."
msgstr ""
"Thẻ từ dùng để mở lối đi khẩn cấp dẫn đến mỏ sắt.\n"
"Có thể đi vào từ thượng tầng Thành phố Roer."

msgctxt "#113 name"
msgid "Millium's Student Notebook"
msgstr "Sổ tay Học viên của Millium"

msgctxt "#113 desc"
msgid "Millium's student notebook. Received from Towa."
msgstr ""
"Sổ tay Học viên dành cho Millium. Nhận được từ hội trưởng Towa.\n"
"Mau đưa nó cho cô ấy nào."

msgctxt "#114 name"

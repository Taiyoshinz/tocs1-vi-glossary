msgid "Medal of Discipline"
msgstr "Huy chương Kỷ cương"

msgctxt "#369 desc"
msgid ""
"[SPD+3/Prevents Delay]\n"
"A medal given to high-achieving students. Focuses wearer."
msgstr ""
"[Tốc+3/Kháng Trì Hoãn]\n"
"Tuyên dương thành tích của học viên, thúc đẩy tinh thần thép."


msgid "Reinford Medal"
msgstr "Huy chương Reinford"

msgctxt "#362 desc"
msgid ""
"[STR+7/DEF+7/ATS+7/ADF+7]\n"
"A memorial medal with the Reinford Company logo carved on it."
msgstr ""
"[SM+7/PT+7/PL+7/PA+7]\n"
"Huy chương kỷ niệm được khắc logo của Tập đoàn RF."


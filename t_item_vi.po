msgid "Medal of Fortitude"
msgstr "Huy chương Bất khuất"

msgctxt "#368 desc"
msgid ""
"[STR+5/Prevents Faint]\n"
"A medal given to high-achieving students. Raises motivation."
msgstr ""
"[SM+5/Kháng Ngất]\n"
"Tuyên dương thành tích của học viên, tràn đầy quyết tâm."


msgid "Pikkard Plush"
msgstr "Búp bê Pikkard"

msgctxt "#363 desc"
msgid ""
"[HP+100/DEF/ADF+5]\n"
"A plush of a strange yet lovable creature. Smells oddly sweet."
msgstr ""
"[HP+100/PT+5/PA+5]\n"
"Búp bê sinh vật đáng yêu. Nó tỏa ra một hương thơm kỳ lạ."


msgid "Sitting Mishy"
msgstr "Mishy ngồi"

msgctxt "#365 desc"
msgid ""
"[DEF+5/SPD+2]\n"
"A strap featuring Mishy. Part of a set."
msgstr ""
"[PT+5/TĐ+2]\n"
"Mishy nằm trong bộ sưu tập móc khóa với nhiều dáng vẻ khác nhau."


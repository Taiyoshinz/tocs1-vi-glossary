#. Cryon Bit
msgctxt "#28 name"
msgid "クリオンビット"
msgstr "Ấu Trùng Băng"

#. A rare infant monster. Has the
#. unusual habit of freezing its
#. prey before consuming it.
msgctxt "#28 desc"
msgid ""
"希少性の高い幼生魔獣。\n"
"獲物を凍らせてから頂くという\n"
"変わった食性を持つ。"
msgstr ""
"Loài ma thú ấu trùng\n"
"cực kỳ quý hiếm.\n"
"Chúng đóng băng con mồi\n"
"rồi mới thưởng thức chúng."

#. Shadow Spirit
msgctxt "#29 name"
msgid "シャドウスピリッツ"
msgstr "Oán Linh Hắc Ám"

#. An eerie spirit that lacks
#. a solid body. Gives those who
#. hear it nightmares, causing
#. them to lose their sanity.
msgctxt "#29 desc"
msgid ""
"実体を持たない不気味な霊魂。\n"
"声を聞いた人間を悪夢に誘い、\n"
"その正気を失わせる。"
msgstr ""
"Khối linh hồn không mang \n"
"hình dạng hữu hình.\n"
"Những người nghe thấy nó\n"
"sẽ rơi vào ác mộng."

#. Ghost Soul
msgctxt "#30 name"
msgid "ゴーストソウル"
msgstr "Hồn Ma"

#. A spirit formed from grudges.
#. Its ominous voice beckons all
#. humans who hear it to an
#. eternal slumber.
msgctxt "#30 desc"
msgid ""
"怨念が集まってできた霊魂。\n"
"人間を終わりなき悪夢に誘う\n"
"禍々しく邪悪な声を持つ。"
msgstr ""
"Khối linh hồn oán niệm.\n"
"Giọng nói của nó sẽ đưa\n"
"con người vào cơn ác mộng\n"
"không hồi kết."

#. Dirty Rat
msgctxt "#31 name"
msgid "ダーティラッチュウ"
msgstr "Chuột Dơ Dáy"

#. A rat monster which lives in
#. dark underground areas. 
#. Pounces on enemies unnoticed,
#. delaying their movement.
msgctxt "#31 desc"
msgid ""
"暗い地下に棲息する鼠型魔獣。\n"
"闇に紛れて飛び掛かり、\n"
"敵の行動を遅らせる。"
msgstr ""
"Ma thú sống dưới lòng đất.\n"
"Nó len lỏi vào bóng tối\n"
"và gây rối loạn cho kẻ địch."

#. Jewel Rat
msgctxt "#32 name"
msgid "ジュエルラッチュウ"
msgstr "Chuột Đá Quý"

#. A quick-witted rat monster
#. with horns as hard as jewels. 
#. Beware its pounce attack.
msgctxt "#32 desc"
msgid ""
"宝石の硬度を持つ角を生やした、\n"
"俊敏な鼠型魔獣。\n"
"飛び掛り攻撃には注意。"
msgstr ""
"Loài ma thú vô cùng nhanh nhẹn\n"
"với chiếc sừng cứng như đá quý.\n"
"Hãy cẩn thận những đòn vồ\n"
"của chúng."

#. Coco Panda
msgctxt "#33 name"
msgid "ココパンダー"
msgstr "Coco Panda"

#. An intelligent, bipedal 
#. monster. Beats humans who 
#. pass by with a stick it made 
#. from a tree branch.
msgctxt "#33 desc"
msgid ""
"知能の高い二足歩行の魔獣。\n"
"木の実を加工した棍棒で\n"
"通りかかる人間を殴りつける。"
msgstr ""
"Loài ma thú hai chân thông minh.\n"
"Nó tấn công người đi đường\n"
"bằng cây gậy gỗ."

#. Sasa Panda
msgctxt "#34 name"
msgid "ササパンダー"
msgstr "Sasa Panda"

#. A surprisingly ferocious panda
#. monster. Wields a piece of
#. bamboo like a weapon to fight
#. off its enemies.
msgctxt "#34 desc"
msgid ""
"意外と凶暴な熊猫型魔獣。\n"
"笹を武器のように扱って\n"
"外敵を退ける。"
msgstr ""
"Loài ma thú vô cùng hung hãn.\n"
"Nó sử dụng cây tre để làm\n"
"vũ khí và xua đuổi kẻ thù."

#. Green Raccoon
msgctxt "#35 name"
msgid "グマーライ"
msgstr "Chồn Xanh"

#. A small and extremely 
#. cautious raccoon. The stick it
#. always carries around was
#. taken from a poisonous plant.
msgctxt "#35 desc"
msgid ""
"注意深い小熊型の魔獣。\n"
"常に持っている曲がった杖は\n"
"毒性の強い植物からとったもの。"
msgstr ""
"Ma thú nhỏ vô cùng cảnh giác.\n"
"Cây gậy mà nó mang theo\n"
"được bẻ từ một loại cây có\n"
"độc tố cao."

#. Orderbelisk
msgctxt "#36 name"
msgid "オーデルベリスク"
msgstr "Cột Lệnh Obelisk"

#. A mysterious, floating pillar.
#. Uses powerful space arts to 
#. erase intruders from existence.
msgctxt "#36 desc"
msgid ""
"意志を持って浮遊する謎の柱。\n"
"強力な空属性のアーツを操り\n"
"侵入者を光の彼方に消し去る。"
msgstr ""
"Cột trụ bí ẩn có ý chí riêng.\n"
"Chúng thao túng art không gian\n"
"để xóa sổ những kẻ xâm nhập\n"
"vào cõi hư vô của ánh sáng."

#. Judge Pillar
msgctxt "#37 name"
msgid "ディザードジャッジ"
msgstr "Cột Phán Quyết"

#. A heavenly pillar which acts
#. as a judge. Stops those who 
#. touch it from moving, and 
#. uses healing arts.
msgctxt "#37 desc"
msgid ""
"審判を司るという天界の柱。\n"
"触れた者の動きを止め、\n"
"強力な回復アーツを発動する。"
msgstr ""
"Cột trụ cai quản sự phán xét.\n"
"Chúng làm bất động những\n"
"kẻ chạm phải, đồng thời kích\n"
"hoạt art hồi phục cực mạnh."

#. Sharkodile
msgctxt "#38 name"
msgid "ワニシャーク"
msgstr "Cá Sập Mấu"

#. An aquatic monster that lives
#. in underground waterways. 
#. Has a giant mouth that 
#. lets it tear through prey.
msgctxt "#38 desc"
msgid ""
"地下水道に棲息する水棲魔獣。\n"
"巨大な口で獲物に噛み付き\n"
"その肉を食い千切る。"
msgstr ""
"Ma thú sinh sống dưới đường\n"
"nước ngầm.\n"
"Chiếc miệng khổng lồ của nó\n"
"có thể xé xác con mồi."

#. Great Sharkodile
msgctxt "#39 name"
msgid "グレートワッシャー"
msgstr "Cá Sập Mấu Siêu To"

#. An aquatic monster that rules
#. the capital's underground
#. waterways. Its jaw is strong
#. enough to grind bone to dust.
msgctxt "#39 desc"
msgid ""
"帝都の地下水道を牛耳る\n"
"大型の水棲魔獣。\n"
"獲物を骨ごと粉々に噛み砕く\n"
"あまりにも強靭な顎を持つ。"
msgstr ""
"Loài ma thú thống trị đường\n"
"nước ngầm của Đế Đô.\n"
"Hàm của nó có thể cắn\n"
"nát xương của con mồi."

#. Creepy Sheep
msgctxt "#40 name"
msgid "ヒツジン"
msgstr "Cừu Gớm"

#. A dynamic sheep monster. 
#. Capable of using an unusual
#. boxing style that lets it put
#. its foes to sleep.
msgctxt "#40 desc"
msgid ""
"活動的なヒツジ型魔獣。\n"
"相手を眠らせる能力を持つ\n"
"独自の拳法を操る。"
msgstr ""
"Loài ma thú hình cừu.\n"
"Nó có thể đi những đường\n"
"quyền khiến đối phương\n"
"rơi vào giấc ngủ."

#. Cherubic Gate
msgctxt "#41 name"
msgid "ケルビムゲイト"
msgstr "Cổng Bệ Thần Cherubim"

#. A floor guardian that has 
#. merged with a door. Fires
#. light rays from the jewel at 
#. its center to confuse foes.
msgctxt "#41 desc"
msgid ""
"扉と一体化した階層の守護者。\n"
"中心の宝玉から認識を乱して\n"
"人を狂わせる怪光線を放つ。"
msgstr ""
"Kẻ giữ tầng đã hợp nhất với\n"
"cánh cửa.\n"
"Chúng bắn ra luồng sáng từ\n"
"tâm thạch làm rối trí kẻ thù."

#. Seraphic Gate
msgctxt "#42 name"
msgid "セラフィムゲイト"
msgstr "Cổng Luyến Thần Seraphim"

#. A glistening floor guardian.
#. Unleashes rays of light and
#. lowers foes' mobility with a
#. cursed roar.
msgctxt "#42 desc"
msgid ""
"光り輝く階層の守護者。\n"
"怪しげな怪光線を放つほか、\n"
"動きを鈍らせる\n"
"呪いの雄叫びを上げる。"
msgstr ""
"Kẻ giữ tầng tỏa ánh chói lòa.\n"
"Chúng phóng ra tia sáng\n"
"quái dị và cất tiếng hú làm\n"
"chậm chân kẻ địch."

#. Gordi Chief
msgctxt "#43 name"
msgid "ゴーディオッサー"
msgstr "Gordi Bố Già"

#. A primate that dwells in
#. the forest. Its blows are so
#. powerful that they knock 
#. the recipient unconscious.
msgctxt "#43 desc"
msgid ""
"森林に棲息する霊長類。\n"
"怪力にモノを言わせた一撃は、\n"
"意識を保てなくなるほど強力。"
msgstr ""
"Chủng linh trưởng sinh sống\n"
"trong rừng rậm.\n"
"Chúng mạnh đến mức có thể\n"
"một đấm làm ngất kẻ địch."

#. Gordi Schnarr
msgctxt "#44 name"
msgid "ゴーディシュナー"
msgstr "Gordi Quái Kiệt"

#. A large monkey monster 
#. that lives deep in the forest. 
#. Its powerful arms are capable 
#. of dealing devastating blows.
msgctxt "#44 desc"
msgid ""
"深い森の奥に住む大猿の魔獣。\n"
"圧倒的な膂力に任せて振るわれる\n"
"豪腕の一撃は凄まじい威力。"
msgstr ""
"Loài ma thú sống sâu trong\n"
"rừng rậm. Cú đấm của nó có thể\n"
"khiến một người không biết trời\n"
"đất trăng sao là gì."

#. War Mantis
msgctxt "#45 name"
msgid "ワーマンティス"
msgstr "Bọ Ngựa Hiếu Chiến"

#. A large mantis monster. 
#. Wields an incredibly sharp
#. scythe capable of decapitating
#. its prey in a single strike.
msgctxt "#45 desc"
msgid ""
"巨大な蟷螂型の魔獣。\n"
"一振りで獲物の首を刈り取る\n"
"強烈な切れ味のカマを持つ。"
msgstr ""
"Ma thú bọ ngựa khổng lồ.\n"
"Đôi càng của chúng sắc đến\n"
"mức có thể gặt lấy thủ cấp\n"
"của kẻ địch trong nháy mắt."

#. Death Sickle
msgctxt "#46 name"
msgid "デスシックル"
msgstr "Bọ Ngựa Tử Liềm"

#. A bipedal mantis monster. Has
#. sharp sickles on its forelegs
#. and attacks humans' necks on
#. sight.
msgctxt "#46 desc"
msgid ""
"二足歩行する蟷螂型の魔獣。\n"
"鋭いカマを両手に持ち、\n"
"人間の急所である\n"
"首を狙って振り下ろす。"
msgstr ""
"Ma thú bọ ngựa khổng lồ.\n"
"Cặp càng của chúng có thể\n"
"lấy đầu kẻ địch chỉ trong\n"
"nháy mắt."

#. Fanged Wolf
msgctxt "#47 name"
msgid "バイトウルフ"
msgstr "Sói Hung Hãn"

#. A wolf monster that moves in
#. packs. Attacks prey with its
#. powerful fangs.
msgctxt "#47 desc"
msgid ""
"群れをなして、強靭な牙で\n"
"獲物に襲い掛かる狼型の魔獣。"
msgstr ""
"Sói ma thú sống theo bầy.\n"
"Chúng lao vào tấn công\n"
"con mồi bằng cặp nanh\n"
"rắn chắc."

#. Greedy Wolf
msgctxt "#48 name"
msgid "グリードウルフ"
msgstr "Sói Tham Lam"

#. A greedy wolf that came from
#. the mountains in search of 
#. food. Pursues prey endlessly,
#. attacking its windpipe first.
msgctxt "#48 desc"
msgid ""
"新たな餌場を求めて山麓から\n"
"やってきた強欲なる狼型魔獣。\n"
"執拗に獲物を追いまわし\n"
"喉笛を食いちぎる。"
msgstr ""
"Sói ma thú tham lam xuống\n"
"núi để tìm món ngon mới.\n"
"Chúng truy sát và cắn đứt\n"
"cuống họng của con mồi."

#. White Fang
msgctxt "#49 name"
msgid "ホワイトファング"
msgstr "Nanh Trắng"

#. A wolf monster with white
#. fur. Roams the highlands
#. and always hunts together
#. with its pack.
msgctxt "#49 desc"
msgid ""
"ノルド高原にいくつかの群れが\n"
"存在する白い体毛の狼型魔獣。\n"
"集団で獲物を狩る習性がある。"
msgstr ""
"Loài sói ma thú lông trắng.\n"
"Chúng sống theo bầy và săn\n"
"mồi ở Cao nguyên Nord."

#. Mad Penguin
msgctxt "#50 name"
msgid "マッドペングー"
msgstr "Cánh Cụt Điên Loạn"

#. An avian monster that lives in
#. bogs and throws small fish.
#. It can't fly, but it doesn't
#. care, either.
msgctxt "#50 desc"
msgid ""
"泥地に棲息する鳥型魔獣。\n"
"川魚を投げつけてくる。\n"
"飛べないことは気にしていない。"
msgstr ""
"Ma thú cánh cụt sống tại\n"
"đầm lầy và ném cá...?\n"
"Chúng không quan tâm\n"
"mình không biết bay."

#. Ball Bat
msgctxt "#51 name"
msgid "ボールバット"
msgstr "Dơi Tròn Trịa"

#. An exceptionally heavy bat
#. monster. Tackles enemies from
#. the air with incredible force,
#. knocking them back.
msgctxt "#51 desc"
msgid ""
"重量級の巨体を誇る蝙蝠型魔獣。\n"
"中空から勢いをつけて体当たりし\n"
"敵を強烈に吹き飛ばす。"
msgstr ""
"Ma thú dơi với trọng lượng\n"
"thuộc cấp vũ trụ thiên hà.\n"
"Chúng lao xuống và đánh\n"
"bay kẻ địch."

#. Metal Bat
msgctxt "#52 name"
msgid "メタルバット"
msgstr "Dơi Sắt"

#. A large bat monster. A steady 
#. diet of ore has made its fur 
#. as hard as steel.
msgctxt "#52 desc"
msgid ""
"巨体の蝙蝠型魔獣。\n"
"鉱物を食べ続けたことによって\n"
"鋼のような硬度の体毛を持った。"
msgstr ""
"Ma thú dơi khổng lồ.\n"
"Do ăn quá nhiều khoáng sản\n"
"mà lông cuả chúng đã trở\n"
"nên cứng như sắt."

#. Death Slugger
msgctxt "#53 name"
msgid "デススラッガー"
msgstr "Pháo Chết Chóc"

#. A purgatorial tank that mows
#. down sinners in its wake. 
#. Moves ceaselessly, firing its
#. cannon with reckless abandon.
msgctxt "#53 desc"
msgid ""
"罪人を踏みつけて\n"
"行進する煉獄の戦車。\n"
"縦横無尽に駆け回り、\n"
"大砲を撃ちまくる。"
msgstr ""
"Chiến xa luyện ngục sẽ\n"
"càn quét những kẻ tội lỗi.\n"
"Chúng lăn xả mọi nơi và\n"
"xả đại bác liên hồi."

#. Demon Rider
msgctxt "#54 name"
msgid "デーモンライダー"
msgstr "Chiến Xa Quỷ"

#. Tank made by alchemy, it
#. can pulverize anything with
#. its cannon. Its charge attack
#. slays warriors in one strike.
msgctxt "#54 desc"
msgid ""
"古代錬金術が生み出した戦闘戦車。呪われし怨念の遺児。何かしらの波動を受け永の眠りより目覚めた。\n"
"その砲から打ち出される無限回転の鉄球は、如何なる物をも粉砕する。\n"
"突進技チャリオッツ・ダッシャーで、一撃で屈強な戦士の息の根をも止める。"
msgstr ""
"Cỗ chiến xa sinh ra từ thuật\n"
"giả kim. Đòn xung kích của\n"
"nó có thể càn quét cả một\n"
"toán chiến binh hùng mạnh."

#. Phalanx J9
msgctxt "#55 name"
msgid "ファランクスJ9"
msgstr "Phalanx J9"

#. A mechanical monster. Has
#. immense firepower, but all
#. else about it is unknown.
msgctxt "#55 desc"
msgid ""
"機械仕掛けの魔獣。\n"
"高い火力を備えており、\n"
"その正体は全くの不明。"
msgstr ""
"Ma thú máy móc.\n"
"Sở hữu hỏa lực mạnh mẽ,\n"
"song lai lịch vẫn còn là\n"
"một ẩn số."

#. Phalanx J9
msgctxt "#56 name"
msgid "ファランクスJ9"
msgstr "Phalanx J9"

#. An archaism designed to aid in
#. conquering enemy strongholds.
#. Fires small missiles effective
#. against bunched-up foes.
msgctxt "#56 desc"
msgid ""
"拠点制圧用の人形兵器。\n"
"密集した敵を殲滅する\n"
"小型ミサイルを積んでいる。"
msgstr ""
"Binh khí hình nhân chuyên\n"
"dùng để trấn áp cứ điểm.\n"
"Tên lửa nhỏ giúp chúng\n"
"tiêu diệt kẻ thù co cụm."

#. Phalanx J9
msgctxt "#57 name"
msgid "ファランクスJ9"
msgstr "Phalanx J9"

#. An archaism designed to aid in
#. conquering enemy strongholds.
#. Fires small missiles effective
#. against bunched-up foes.
msgctxt "#57 desc"
msgid ""
"拠点制圧用の人形兵器。\n"
"密集した敵を殲滅する\n"
"小型ミサイルを積んでいる。"
msgstr ""
"Binh khí hình nhân chuyên\n"
"dùng để trấn áp cứ điểm.\n"
"Tên lửa nhỏ giúp chúng\n"
"tiêu diệt kẻ thù co cụm."

#. Phalanx J9
msgctxt "#58 name"
msgid "ファランクスJ9"
msgstr "Phalanx J9"

#. An archaism designed to aid in
#. conquering enemy strongholds.
#. Fires small missiles effective
#. against bunched-up foes.
msgctxt "#58 desc"
msgid ""
"拠点制圧用の人形兵器。\n"
"密集した敵を殲滅する\n"
"小型ミサイルを積んでいる。"
msgstr ""
"Binh khí hình nhân chuyên\n"
"dùng để trấn áp cứ điểm.\n"
"Tên lửa nhỏ giúp chúng\n"
"tiêu diệt kẻ thù co cụm."

#. Fate Spinner
msgctxt "#59 name"
msgid "フェイトスピナー"
msgstr "Nhện Dệt Mệnh"

#. A menacing monster with two
#. sharp claws. Attacks with a
#. poisonous liquid that causes 
#. fires and hallucinations.
msgctxt "#59 desc"
msgid ""
"両手に鋭いツメを持つ\n"
"禍々しい姿の魔獣。\n"
"幻覚・発火作用のある\n"
"凶悪な毒液を吐く。"
msgstr ""
"Loài ma thú tà ác sở\n"
"hữu đôi vuốt sắc bén.\n"
"Độc của chúng có thể\n"
"gây cháy và ảo giác."

#. Fate Spinner
msgctxt "#60 name"
msgid "フェイトスピナー"
msgstr "Nhện Dệt Mệnh"

#. A menacing monster with two
#. sharp claws. Attacks with a
#. poisonous liquid that causes 
#. fires and hallucinations.
msgctxt "#60 desc"
msgid ""
"両手に鋭いツメを持つ\n"
"禍々しい姿の魔獣。\n"
"幻覚・発火作用のある\n"
"凶悪な毒液を吐く。"
msgstr ""
"Loài ma thú tà ác sở\n"
"hữu đôi vuốt sắc bén.\n"
"Độc của chúng có thể\n"
"gây cháy và ảo giác."

#. Acerbic Tomartian
msgctxt "#61 name"
msgid "にがトマトマン"
msgstr "Cà Chua Đắng Dị"

#. A living acerbic tomato, born
#. from a sudden mutation. Its
#. juices are bitter enough to
#. make you go insane.
msgctxt "#61 desc"
msgid ""
"突然変異で生まれた\n"
"“にがトマト”の化身。\n"
"途轍もなく苦い果汁は\n"
"思わず正気を失うほど。"
msgstr ""
"Thể đột biến của giống\n"
"cà chua đắng.\n"
"Vị của nó đắng đến mức\n"
"khiến người ta loạn trí."

#. Hellish Tomartian
msgctxt "#62 name"
msgid "かれにがトマトマン"
msgstr "Cà Chua Đắng Héo"

#. A mutation of a mutation,
#. with an obscenely hellish
#. level of bitterness.
msgctxt "#62 desc"
msgid ""
"にがトマトの化身の中でも\n"
"更なる突然変異を起こし、\n"
"地獄のような辛さまでも\n"
"兼ね備えてしまった魔獣。"
msgstr ""
"Thể siêu biến dị của giống\n"
"cà chua đắng, nó có thêm\n"
"vị cay xé lưỡi đến từ địa\n"
"ngục."

#. Thunder Quaker
msgctxt "#63 name"
msgid "サンダークエイク"
msgstr "Cá Lôi Chấn"

#. An ancient fish capable of
#. producing electricity in its
#. body. Can char foes within
#. a wide area.
msgctxt "#63 desc"
msgid ""
"帯電する体を持つ古代魚。\n"
"広範囲に激しい放電を行い、\n"
"すべてを黒コゲにしてしまう。"
msgstr ""
"Loài cá cổ đại tích trữ\n"
"điện trong cơ thể.\n"
"Nó phóng điện và thiêu\n"
"rụi mọi thứ trong tầm."

#. Wandering Armor
msgctxt "#64 name"
msgid "ワンダーアーマー"
msgstr "Bộ Giáp Lang Thang"

#. A suit of armor from the
#. Middle Ages that gained the
#. ability to move in a strange
#. environment. Very sturdy.
msgctxt "#64 desc"
msgid ""
"特殊な場に感応して\n"
"ひとりでに動き出した中世の鎧。\n"
"相当な防御力を誇っている。"
msgstr ""
"Bộ giáp thời Trung Cổ\n"
"bỗng di chuyển được khi ở\n"
"trong môi trường đặc thù.\n"
"Rất chi là cứng cáp."

#. Wandering Sword
msgctxt "#65 name"
msgid "ワンダーソード"
msgstr "Kiếm Lang Thang"

#. A sword from the Middle Ages
#. capable of fighting by itself.
#. Can take the life of an
#. intruder in a single blow.
msgctxt "#65 desc"
msgid ""
"意志を持つ中世の剣。\n"
"侵入者の命を刈り取る\n"
"必殺の一撃を繰り出す。"
msgstr ""
"Thanh kiếm Trung Cổ sở hữu\n"
"ý chí của riêng mình\n"
"Chúng có thể lấy mạng kẻ\n"
"xâm nhập chỉ với một chém."

#. Nosferatu
msgctxt "#66 name"
msgid "ノスフェラトゥ"
msgstr "Nosferatu"

#. An immortal king from ancient
#. legends with authority over
#. souls. Takes the souls of the
#. innocent and devours them.
msgctxt "#66 desc"
msgid ""
"帝国の古き言い伝えにもある、\n"
"魂魄を司りし《不死の王》。\n"
"生者をその身に取り込み\n"
"罪なき魂を喰らい尽くす。"
msgstr ""
"Vua Bất Tử huyền thoại\n"
"từ thời Đế Quốc cổ đại.\n"
"Nó hấp thụ và ngấu nghiến\n"
"linh hồn của kẻ xấu số."

#. NT-I
msgctxt "#67 name"
msgid "ＮＴ－Ⅰ"
msgstr "NT-I"

#. A self-detonating mine set 
#. by C. Causes a large-scale
#. explosion.
msgctxt "#67 desc"
msgid ""
"《Ｃ》の設置した自動機雷。\n"
"周囲を巻き込んで爆発を起こす。"
msgstr ""
"Mìn tự phát nổ được\n"
"thiết lập bởi C.\n"
"Nó sẽ gây ra một vụ\n"
"nổ lớn trong phạm vi."

#. Cursed Sculpture
msgctxt "#68 name"
msgid "ガースカルプチュア"
msgstr "Tượng Nguyền Rủa"

#. A devil said to have existed
#. since the Dark Ages. With its
#. spread wings, it is a symbol
#. of fear.
msgctxt "#68 desc"
msgid ""
"暗黒時代にいたと言われる悪魔。\n"
"羽根を広げた姿は恐怖の象徴。"
msgstr ""
"Ác ma đã từng xuất hiện\n"
"tại Thời Kỳ Tăm Tối.\n"
"Đôi cánh dang rộng của nó\n"
"tượng trưng cho nỗi sợ hãi."

#. Pit Demon
msgctxt "#69 name"
msgid "ピットデーモン"
msgstr "Ác Quỷ Hố Sâu"

#. A devil's minion, mentioned in
#. the Testaments. Charms foes
#. with waves, luring them into
#. an eternal slumber.
msgctxt "#69 desc"
msgid ""
"聖典にも伝わる悪魔の使い。\n"
"禍々しい波動で人間を魅了し、\n"
"二度と覚めることのない\n"
"深淵の眠りへと誘う。"
msgstr ""
"Kẻ sai dịch của ác ma xuất\n"
"hiện trong Thánh Điển.\n"
"Chúng dẫn dụ loài người\n"
"vào giấc ngủ sâu thẳm."

#. Flying Feline
msgctxt "#70 name"
msgid "飛び猫"
msgstr "Mèo Bay"

#. A winged feline monster. 
#. Relentlessly pursues its
#. prey, attacking with kicks
#. from above.
msgctxt "#70 desc"
msgid ""
"翼の生えた猫型魔獣。\n"
"執拗に獲物を追いかけ\n"
"空から連続キックを繰り出す。"
msgstr ""
"Ma thú có cánh dạng mèo.\n"
"Chúng bất chấp săn đuổi\n"
"con mồi và tấn công liên\n"
"hoàn từ trên cao."

#. White Feline
msgctxt "#71 name"
msgid "白飛び猫"
msgstr "Mèo Trắng Bay"

#. A subspecies of flying feline
#. with white fur. Once raised 
#. as a pet by a noble, but was
#. abandoned and turned feral.
msgctxt "#71 desc"
msgid ""
"白い体毛を持つ飛び猫の亜種。\n"
"貴族が愛玩用に飼っていたが\n"
"地下に捨てられて野性化した。"
msgstr ""
"Một chủng khác của mèo bay\n"
"với bộ lông trắng muốt.\n"
"Chúng từng được quý tộc nuôi,\n"
"nhưng sau này bị vứt bỏ."

#. Dastardly Amalgam
msgctxt "#72 name"
msgid "ダスタードグミ"
msgstr "Kẹo Dẻo Hèn Nhát"

#. A mollusk monster that covers
#. itself with broken stones and
#. rocks for protection.
msgctxt "#72 desc"
msgid ""
"崩れた石材などを身にまとい\n"
"高い防御力を得た軟体の魔獣。"
msgstr ""
"Loài ma thú thân mềm\n"
"sử dụng những tảng đá vỡ\n"
"để bao bọc bản thân."

#. Frost Biter
msgctxt "#73 name"
msgid "フロストバイター"
msgstr "Kẹo Dẻo Đớp Lạnh"

#. A mollusk monster covered
#. with very cold minerals. All
#. who touch it turn to ice.
msgctxt "#73 desc"
msgid ""
"超低温の鉱物を身に纏う軟体魔獣。\n"
"触れるもの全てを凍てつかせる。"
msgstr ""
"Loài ma thú thân mềm được\n"
"bao bọc bởi các loại khoáng\n"
"sản lạnh lẽo.\n"
"Chạm vào là đông đá như chơi."

#. Coin Beetle
msgctxt "#74 name"
msgid "コインビートル"
msgstr "Bọ Đồng Xu"

#. A golden-colored beetle. Its 
#. carapace is hard like a coin.
msgctxt "#74 desc"
msgid ""
"硬貨のように固い皮膚を持つ。\n"
"黄金色の甲虫型魔獣。"
msgstr ""
"Loài ma thú có màu vàng kim.\n"
"Lớp vỏ của nó cứng không\n"
"khác gì một đồng xu."

#. Metal Beetle
msgctxt "#75 name"
msgid "メタルビートル"
msgstr "Bọ Thép"

#. A beetle with a metallic
#. shell. Was once frequently
#. dug up when people mistook 
#. them for actual ore.
msgctxt "#75 desc"
msgid ""
"板金のような外殻を持つ\n"
"甲虫型魔獣で、昔は\n"
"よく鉄鉱石と間違われて\n"
"発掘されていたという。"
msgstr ""
"Loài ma thú với lớp vỏ\n"
"như được làm bằng thép.\n"
"Các thợ mỏ thường nhằm\n"
"chúng với mấy quặng sắt."

#. Attack Dog
msgctxt "#76 name"
msgid "アタックドッグ"
msgstr "Chó Hung Hãn"

#. A canine monster with a 
#. violent temperament. Known
#. for the spines covering much
#. of its body.
msgctxt "#76 desc"
msgid ""
"気性の荒い犬型魔獣。\n"
"全身から生えたトゲが特徴。"
msgstr ""
"Loài ma thú với\n"
"tính khí hung hãn.\n"
"Đặc điểm của chúng là\n"
"có gai mọc toàn thân."

#. Dark Canine
msgctxt "#77 name"
msgid "ドッグザダーク"
msgstr "Chó Săn Bóng Đêm"

#. A nocturnal canine monster
#. that made its way into the
#. castle. Aggressive, with
#. poison in its claws.
msgctxt "#77 desc"
msgid ""
"異変によって古城に入り込んだ\n"
"夜行性の犬型魔獣。\n"
"凶暴な性格で爪には猛毒がある。"
msgstr ""
"Loài ma thú hoạt động về đêm\n"
"đã xâm nhập vào lâu đài cổ.\n"
"Chúng rất hung hãn với bộ\n"
"móng vuốt chứa độc tố."

#. Attack Dog G
msgctxt "#78 name"
msgid "アタックドッグＧ"
msgstr "Chó Hung Hãn G"

#. The name given to especially
#. large attack dogs. They are
#. even more dangerous than
#. the regular kind.
msgctxt "#78 desc"
msgid ""
"アタックドッグの中でも\n"
"特に巨大な個体をこう呼ぶ。\n"
"危険度も一回り上。"
msgstr ""
"Tên gọi được đặt cho\n"
"Sói Hung Hãn lớn nhất,\n"
"và cũng là cá thể\n"
"nguy hiểm nhất."

#. Blade Horn
msgctxt "#79 name"
msgid "ブレードホーン"
msgstr "Bọ Sừng Kiếm"

#. A large insect monster with a
#. horn resembling a blade. Uses
#. it to forcefully shatter foes.
msgctxt "#79 desc"
msgid ""
"剣の刀身のような角を持つ\n"
"大型の昆虫魔獣。\n"
"勢いに任せて敵を叩き割る。"
msgstr ""
"Loài ma thú hình bọ với\n"
"chiếc sừng tựa như lưỡi kiếm.\n"
"Chúng mượn đà lao tới\n"
"để bổ đôi kẻ địch."

#. Blue Horn
msgctxt "#80 name"
msgid "ブルブーン"
msgstr "Bọ Sừng Xanh"

#. A beetle covered with a hard
#. shell. Knocks prey unconscious
#. with its powerful horn.
msgctxt "#80 desc"
msgid ""
"硬い外殻に覆われた甲虫魔獣。\n"
"自慢の巨角で獲物を\n"
"突き飛ばし気絶させる。"
msgstr ""
"Ma thú bọ với\n"
"lớp vỏ ngoài cứng cáp.\n"
"Chúng húc sừng để\n"
"đánh ngất kẻ địch."

#. Blade Pincer
msgctxt "#81 name"
msgid "ハッシムゥ"
msgstr "Bọ Càng Kiếm"

#. An arthropod monster with a 
#. pair of sharp pincers and a 
#. hard shell. Loathed by people
#. for munching on crops.
msgctxt "#81 desc"
msgid ""
"硬い外殻に覆われた、\n"
"大きなハサミを持つ節足魔獣。\n"
"畑の穀物を食い荒らすため\n"
"人々に忌み嫌われている。"
msgstr ""
"Ma thú cứng cáp với\n"
"bộ càng kiếm sắc bén.\n"
"Chúng bị ghét vì phá\n"
"hoại mùa màng."

#. Steel Ladybug
msgctxt "#82 name"
msgid "スティルレディバー"
msgstr "Bọ Bọc Thép"

#. A beetle monster with a shell
#. of steel. Its sharp claws can
#. snap trees in half.
msgctxt "#82 desc"
msgid ""
"鋼鉄の外殻を持つ昆虫型魔獣。\n"
"鋭いハサミを使って\n"
"大木をもなぎ倒してしまう。"
msgstr ""
"Loài ma thú hình bọ\n"
"với lớp vỏ thép.\n"
"Cặp càng của nó có thể\n"
"đốn cả một cái cây to."

#. Claydoll
msgctxt "#83 name"
msgid "ドグドール"
msgstr "Rối Đất Sét"

#. An ancient humanoid that
#. roams the old schoolhouse's
#. underground area, repelling
#. intruders.
msgctxt "#83 desc"
msgid ""
"地下を徘徊し侵入者を退ける、\n"
"正体不明の古代人形。"
msgstr ""
"Con rối cổ đại lang thang\n"
"dưới lòng đất với mục đích\n"
"đánh đuổi kẻ xâm nhập."

#. Iglute Garmr
msgctxt "#84 name"
msgid "イグルートガルム"
msgstr "Iglute Garmr"

#. A stone gargoyle spoken of in
#. Erebonian legends. Repels
#. intruders with powerful
#. gusts of wind.
msgctxt "#84 desc"
msgid ""
"旧校舎の奥に鎮座していた、\n"
"帝国の伝承にもある石の守護者。\n"
"強烈な突風を巻き起こして\n"
"侵入者を吹き飛ばす。"
msgstr ""
"Kẻ canh giữ bằng đá từng\n"
"xuất hiện trong truyền thuyết.\n"
"Nó tạo ra cơn cuồng phong\n"
"để thổi bay kẻ địch."

#. Iglute Garmr
msgctxt "#85 name"
msgid "イグルートガルム"
msgstr "Iglute Garmr"

#. A stone gargoyle spoken of in
#. Erebonian legends. Its sturdy
#. body repels physical attacks.
msgctxt "#85 desc"
msgid ""
"旧校舎の奥に鎮座していた、\n"
"帝国の伝承にもある石の守護者。\n"
"凄まじい硬度の体は\n"
"物理攻撃を弾いてしまう。"
msgstr ""
"Kẻ canh giữ bằng đá từng\n"
"xuất hiện trong truyền thuyết.\n"
"Cơ thể cứng cáp của nó\n"
"có thể phản đòn vật lý."

#. Iglute GarmrEVNeck
msgctxt "#86 name"
msgid "イグルートガルムEV首"
msgstr "Iglute GarmrEV - Cổ"

#. Guardian of the ruins, 
#. designed to repel intruders.
#. Physical attacks aren't very
#. effective against it.
msgctxt "#86 desc"
msgid "侵入者撃退用の遺跡の番人。物理攻撃が効きづらい。"
msgstr ""
"Kẻ canh giữ có nhiệm vụ\n"
"đánh đuổi kẻ xâm nhập.\n"
"Nó chống chọi rất tốt trước\n"
"các đòn tấn công vật lý."

#. Obsidian Garmr
msgctxt "#87 name"
msgid "ネグロガルム"
msgstr "Hắc Garmr"

#. A jet-black stone guardian.
#. Its powerful tail strikes are
#. capable of forcing anything
#. aside.
msgctxt "#87 desc"
msgid ""
"漆黒の体を持つ石の守護者。\n"
"圧倒的な巨躯から繰り出される\n"
"尾の一撃は、全てをなぎ払う。"
msgstr ""
"Kẻ canh giữ bằng đá đen tuyền.\n"
"Những đòn quật đuôi của nó\n"
"có thể đánh bay mọi thứ."

#. Mantrap
msgctxt "#88 name"
msgid "マントラップ"
msgstr "Cây Ăn Thịt"

#. A plant-like monster that
#. roams highways. Draws 
#. impurities from below the
#. ground and attacks with them.
msgctxt "#88 desc"
msgid ""
"街道を徘徊する植物型魔獣。\n"
"深層から汲み上げられた\n"
"大地の穢れを敵に吹きかける。"
msgstr ""
"Ma thú thực vật lảng\n"
"vảng trên đường lộ.\n"
"Chúng hút chất ô nhiễm\n"
"từ đất và phóng vào kẻ địch."

#. Mad Weed
msgctxt "#89 name"
msgid "マッドウィード"
msgstr "Cỏ Điên"

#. A mysterious plant said to
#. bloom in the abyss. Produces
#. a miasma that lowers foes'
#. vitality significantly.
msgctxt "#89 desc"
msgid ""
"深淵に咲くという正体不明の植物。\n"
"生命力を著しく低下させる\n"
"穢れた瘴気を無尽蔵に発生させる。"
msgstr ""
"Thực vật bí ẩn được cho là\n"
"sinh ra từ vực thẳm.\n"
"Chúng phóng ra khí độc\n"
"gây hại đến sức sống."

#. Venus Mantrap
msgctxt "#90 name"
msgid "ヴィナスマントラ"
msgstr "Cây Ăn Thịt Quỷ Dị"

#. A three-headed plant monster.
#. Stores impurities within its
#. body, which it sprays at its
#. enemies.
msgctxt "#90 desc"
msgid ""
"三ツ首の植物型魔獣。\n"
"大量の穢れを体内に蓄えており、\n"
"敵対するものには\n"
"容赦なく吹きつける。"
msgstr ""
"Ma thú thực vật ba đầu.\n"
"Chúng tích tụ chất ô nhiễm\n"
"trong cơ thể và phóng chúng\n"
"về phía kẻ địch."

#. Pit Cerberus
msgctxt "#91 name"
msgid "ピットケルベロ"
msgstr "Cerberus Hố Sâu"

#. A plant-like monster that
#. roams the darkness. Blows a
#. deadly miasma that instantly
#. takes away foes' vision.
msgctxt "#91 desc"
msgid ""
"闇間を徘徊する植物型魔獣。\n"
"獲物の視界を瞬く間に奪う\n"
"凶悪な瘴気を吹きつける。"
msgstr ""
"Ma thú thực vật lảng vảng\n"
"tại những nơi tăm tối.\n"
"Chúng phóng ra chướng khí\n"
"làm mù lòa kẻ địch."

#. Ol-Gadia
msgctxt "#92 name"
msgid "オル・ガディア"
msgstr "Thủ Hộ Cổ Đại"

#. A headless knight that 
#. emerged from within the 
#. red door. It seems to be 
#. designed to serve as a 'trial.'
msgctxt "#92 desc"
msgid ""
"赤い扉の奥から現れた\n"
"首の無い騎士人形。\n"
"何らかの試練として\n"
"立ちはだかっている。"
msgstr ""
"Kỵ sĩ không đầu xuất hiện\n"
"cùng với cánh cửa đỏ.\n"
"Nó đóng vai trò như\n"
"một kẻ thách thức."

#. Ol-Gadia
msgctxt "#93 name"
msgid "オル・ガディア"
msgstr "Thủ Hộ Cổ Đại"

#. A headless knight that 
#. emerged from within the 
#. red door. It seems to be 
#. designed to serve as a 'trial.'
msgctxt "#93 desc"
msgid ""
"赤い扉の奥から現れた\n"
"首の無い騎士人形。\n"
"何らかの試練として\n"
"立ちはだかっている。"
msgstr ""
"Kỵ sĩ không đầu xuất hiện\n"
"cùng với cánh cửa đỏ.\n"
"Nó đóng vai trò như\n"
"một kẻ thách thức."

#. Og-Jior
msgctxt "#94 name"
msgid "オグ・ジオール"
msgstr "Og-Giol"

#. Keeper of an ancient ruin,
#. it forcibly repels intruders. 
#. Uses its giant iron sword 
#. to pulverize its foes.
msgctxt "#94 desc"
msgid ""
"侵入者撃退用の遺跡の番人。\n"
"巨大な鉄の剣でもって、\n"
"侵入者を砕き散らす。"
msgstr ""
"Kẻ canh giữ tan tàn tích cổ.\n"
"Nó sử dụng thanh kiếm sắt\n"
"khổng lồ để đánh tan kẻ\n"
"xâm nhập."

#. Stealth Turtle
msgctxt "#95 name"
msgid "ドゴドゴ"
msgstr "Rùa Mai Phục"

#. A ferocious turtle monster.
#. Hides itself in the shadows
#. of bushes, attacking prey 
#. as it passes by.
msgctxt "#95 desc"
msgid ""
"凶暴な亀型魔獣。\n"
"茂みの影などに潜み、\n"
"通りかかる獲物に襲い掛かる。"
msgstr ""
"Ma thú rùa hung bạo.\n"
"Chúng trốn tại những nơi\n"
"khuất bóng và phục kích\n"
"những con mồi xấu số."

#. Zaurtoise
msgctxt "#96 name"
msgid "ザウタス"
msgstr "Rùa Dữ Dằn"

#. A turtle monster with a hard
#. shell. It being on the slow
#. side hasn't stopped it from
#. prospering in the highlands.
msgctxt "#96 desc"
msgid ""
"硬い甲羅を持つ亀型魔獣。\n"
"鈍重ながらも広い高原で\n"
"獲物を狩って生きてきた\n"
"凶暴な魔獣の一つ。"
msgstr ""
"Một trong những loài\n"
"ma thú hung bạo nhất.\n"
"Dù chậm chạp, nhưng chúng\n"
"vẫn sống tốt tại cao nguyên."

#. Elvavria
msgctxt "#97 name"
msgid "エルヴァヴリア"
msgstr "Elvavria"

#. An archaism from the Middle
#. Ages, armed with numerous
#. weapons. Paralyzes foes with
#. wide-reaching beams.
msgctxt "#97 desc"
msgid ""
"強力な兵器を多数搭載した、\n"
"中世のものと見られる人形兵器。\n"
"戦域全体にビームを照射し\n"
"全ての敵を麻痺させる。"
msgstr ""
"Binh khí hình nhân hùng mạnh\n"
"tồn tại từ thời Trung Cổ.\n"
"Chúng làm tê liệt kẻ địch\n"
"bằng chùm tia sáng dữ dội."

#. Kazakh Doven B
msgctxt "#98 name"
msgid "カザックドーベンＢ"
msgstr "Ma Khuyển Cossack B"

#. A military monster trained 
#. by the provincial army. 
#. Coordinates with allies to be
#. sure their prey can't escape.
msgctxt "#98 desc"
msgid ""
"領邦軍で訓練された軍用魔獣。\n"
"統率のとれた連携攻撃で\n"
"獲物を決して逃がしはしない。"
msgstr ""
"Ma thú quân sự được huấn luyện\n"
"bởi Quân đội Lãnh địa.\n"
"Không con mồi nào có thể thoát\n"
"khỏi sự phối hợp của chúng."

#. Kazakh Doven R
msgctxt "#99 name"
msgid "カザックドーベンＲ"
msgstr "Ma Khuyển Cossack R"

#. A military monster used by the
#. provincial army. Rouses allies
#. with a howl, working with
#. them to deal great damage.
msgctxt "#99 desc"
msgid ""
"領邦軍で運用される軍用魔獣。\n"
"遠吠えで仲間を奮い立たせ、\n"
"凄まじい連携攻撃を繰り出す。"
msgstr ""
"Ma thú quân sự được huấn luyện\n"
"bởi Quân đội Lãnh địa.\n"
"Nó cất tiếng hú để khích lệ\n"
"đồng đội."

#. Kazakh Doven G
msgctxt "#100 name"
msgid "カザックドーベンＧ"
msgstr "Ma Khuyển Cossack G"

#. A military monster released by
#. the Imperial Liberation Front.
#. Powerful enough to break 
#. through thick armor.
msgctxt "#100 desc"
msgid ""
"帝国解放戦線が放った軍用魔獣。\n"
"固い装甲を破壊するほどの\n"
"強靭な力を持っている。"
msgstr ""
"Ma thú quân sự được thả bởi\n"
"Trận Tuyến Giải Phóng Đế Quốc.\n"
"Cú đớp của chúng có thể\n"
"xuyên thủng cả giáp cứng."

#. Zesvia
msgctxt "#101 name"
msgid "ゼスウィア"
msgstr "Zesvia"

#. A spider monster that has
#. existed since antiquity. 
#. Feared as the cause of 
#. innumerable plagues.
msgctxt "#101 desc"
msgid ""
"太古に棲息した蜘蛛型魔獣。\n"
"様々な疫病の発生源となり、\n"
"人々に恐れられた。"
msgstr ""
"Ma thú nhện đã tồn tại\n"
"từ thuở chí kim.\n"
"Nó là căn nguyên của rất nhiều\n"
"loại bệnh tật."

#. Ginosha-Zanak
msgctxt "#102 name"
msgid "ギノシャ・ザナク"
msgstr "Ginosha-Zanak"

#. Sealed away as an 'evil djinn'
#. in ancient times. Binds prey 
#. with very hard threads for its
#. children to devour.
msgctxt "#102 desc"
msgid ""
"《悪しき精霊》として大昔に\n"
"封じられたとされる巨大蜘蛛。\n"
"鋼の硬度の糸で生物を縛り、\n"
"我が子の餌としてしまう。"
msgstr ""
"Ma thú cổ xưa đã bị phong\n"
"ấn dưới dạng Ác Tinh Linh.\n"
"Nó săn các con mồi để làm\n"
"thức ăn cho con non."

#. Deathcargot
msgctxt "#103 name"
msgid "デスカルゴ"
msgstr "Ốc Sên Quỷ"

#. A land-dwelling mollusk 
#. monster with a hard shell. 
#. Steals life from its prey then
#. finishes it with water arts.
msgctxt "#103 desc"
msgid ""
"硬い殻を被った陸生の軟体魔獣。\n"
"獲物の体力を奪い取り、\n"
"水のアーツでとどめを刺す。"
msgstr ""
"Ma thú thân mềm sống\n"
"trong lớp vỏ cứng.\n"
"Chúng hút cạn sức sống và\n"
"kết liễu con mồi bằng art thủy."

#. Time Snail
msgctxt "#104 name"
msgid "ジャークマイマイ"
msgstr "Ốc Sên Tà Ác"

#. A mollusk monster with a
#. hard shell. Stops prey in 
#. its tracks with time arts 
#. and slowly absorbs nutrients.
msgctxt "#104 desc"
msgid ""
"超硬度の殻を持つ軟体魔獣。\n"
"時のアーツで獲物を仕留め\n"
"ゆっくりと養分を吸い取る。"
msgstr ""
"Ma thú thân mềm sống\n"
"trong lớp vỏ siêu cứng.\n"
"Nó ra tay bằng art thời gian\n"
"và hút lấy sức sống kẻ địch."

#. Evil Crow
msgctxt "#105 name"
msgid "バドクロウ"
msgstr "Quạ Tàn Ác"

#. An unpleasant bird with a 
#. distinctive large beak. Has a
#. ferocious appetite, swallowing
#. small creatures whole.
msgctxt "#105 desc"
msgid ""
"大きなクチバシが特徴の怪鳥。\n"
"食欲旺盛で小型の動物なら\n"
"丸呑みにしてしまうほど。"
msgstr ""
"Loài chim quái dị với\n"
"chiếc mỏ siêu lớn.\n"
"Chúng loài phàm ăn\n"
"nuốt trọn các sinh vật nhỏ."

#. Scavenger Crow
msgctxt "#106 name"
msgid "ルータークロウ"
msgstr "Quạ Lùng Sục"

#. A strange kind of bird that
#. lives underground. Spends 
#. much of its time scouring 
#. waterways for food.
msgctxt "#106 desc"
msgid ""
"空の無い地下に棲息する\n"
"珍しい鳥型魔獣。\n"
"普段は水路の餌を漁っている。"
msgstr ""
"Ma thú chim hiếm thấy\n"
"sống dưới lòng đất.\n"
"Chúng thường săn cá ở khu\n"
"vực đường nước ngầm."

#. Ripper Squirrel
msgctxt "#107 name"
msgid "リッパースクロウ"
msgstr "Sóc Rạch Mồi"

#. An adorable but deadly 
#. monster with a sharp tail. 
#. Its spin attack is incredibly 
#. dangerous.
msgctxt "#107 desc"
msgid ""
"可愛らしい見た目とは裏腹に\n"
"鋭い刃物のような尾を持つ魔獣。\n"
"その回転攻撃は脅威の一言。"
msgstr ""
"Trái ngược với vẻ ngoài\n"
"đáng yêu, loài ma thú này\n"
"sở hữu chiếc đuôi sắc như\n"
"dao cạo."

#. King Dragonfly
msgctxt "#108 name"
msgid "ダイオウヤンマ"
msgstr "Chuồn Chuồn Đại Vương"

#. A large dragonfly monster 
#. that flies around near fields. 
#. Expels poisonous liquids 
#. from an organ in its body.
msgctxt "#108 desc"
msgid ""
"畑の周辺を飛び回っている\n"
"巨大な蜻蛉型の魔獣。\n"
"体内の毒袋からの体液を飛ばす。"
msgstr ""
"Ma thú chuồn chuồn bay quanh\n"
"tại những nơi đồng ruộng.\n"
"Chúng phun độc trong cơ thể\n"
"về phía kẻ địch."

#. Crimson Dragonfly
msgctxt "#109 name"
msgid "オニアカネ"
msgstr "Chuồn Chuồn Quỷ"

#. A large, red dragonfly 
#. monster. Sprays lethal 
#. poison, mandating 
#. caution when fighting one.
msgctxt "#109 desc"
msgid ""
"全身が真っ赤に染まった\n"
"巨大な蜻蛉型の魔獣。\n"
"猛毒の飛沫を飛ばすため\n"
"注意が必要。"
msgstr ""
"Ma thú chuồn chuồn đỏ thẫm.\n"
"Cần cẩn trọng trước những đòn\n"
"phun độc chết người của nó."

#. Scary Dinosaur
msgctxt "#110 name"
msgid "スケイリーダイナ"
msgstr "Khủng Long Kinh Hoàng"

#. A ferocious lizard monster.
#. Releases sound waves by
#. vibrating its dorsal fin, then
#. crushes prey with its teeth.
msgctxt "#110 desc"
msgid ""
"あまりに凶暴な蜥蜴型の魔獣。\n"
"背びれを震わせて怪音波を発し\n"
"弱った獲物を噛み砕く。"
msgstr ""
"Ma thú khủng long hung tàn.\n"
"Chúng rung vây lưng để phát ra\n"
"sóng âm kỳ lạ, sau đó nghiền\n"
"nát con mồi bằng bộ hàm khủng."

#. Turtle Bug
msgctxt "#111 name"
msgid "タートルバグ"
msgstr "Bọ Rùa"

#. An arthropod monster with a 
#. hard shell. Stores high
#. pressure gas in its body, 
#. which it uses to attack foes.
msgctxt "#111 desc"
msgid ""
"体内に高圧ガスを溜め込んだ、\n"
"固い甲殻を持つ節足魔獣。\n"
"外敵には容赦なくガスを噴く。"
msgstr ""
"Loài ma thú chân đốt sở hữu\n"
"lớp vỏ cứng cáp.\n"
"Nó sẽ phun khí gas tích tụ\n"
"trong cơ thể lên kẻ địch."

#. Platinum Bug
msgctxt "#112 name"
msgid "プラティナバグ"
msgstr "Bọ Bạch Kim"

#. An arthropod with a carapace 
#. as hard as stone. Secretes a
#. highly unpleasant smelling
#. fluid, making enemies faint.
msgctxt "#112 desc"
msgid ""
"岩のような甲羅を持つ節足魔獣。\n"
"凄まじい臭気の体液を分泌し\n"
"外敵を気絶させてしまう。"
msgstr ""
"Loài ma thú chân đốt\n"
"sở hữu lớp vỏ cứng như đá.\n"
"Chúng tiết ra dịch thối kinh\n"
"hồn khiến kẻ địch ngất lịm."

#. Hornteater
msgctxt "#113 name"
msgid "ホーンティータ"
msgstr "Thú Sừng Ăn Kiến"

#. A monster with a hard carapace
#. over its back. Impales prey
#. with its horns, then slowly 
#. eats it with its long tongue.
msgctxt "#113 desc"
msgid ""
"背中を硬い甲殻に覆われた魔獣。\n"
"２本のツノを獲物に突き刺して、\n"
"ゆっくりと長い舌で食らう。"
msgstr ""
"Loài ma thú với lớp vỏ cứng.\n"
"Chúng đâm phập hai chiếc sừng\n"
"vào con mồi, rôi thong thả\n"
"đánh chén bằng chiếc lưỡi dài."

#. Brutal Buffa
msgctxt "#114 name"
msgid "ブルートバファル"
msgstr "Trâu Tàn Bạo"

#. A buffalo monster that is
#. always on the move across 
#. the highlands. Mostly docile,
#. but fiercely territorial.
msgctxt "#114 desc"
msgid ""
"広大な高原を常に移動し続け\n"
"住処を転々とする牛型魔獣。\n"
"温和だが縄張り意識は強い。"
msgstr ""
"Ma thú trâu liên tục di chuyển\n"
"trên cao nguyên rộng lớn.\n"
"Tuy tính tình hiền hòa, nhưng\n"
"có tính lãnh thổ rất cao."

#. Anteater
msgctxt "#115 name"
msgid "アンティータ"
msgstr "Thú Ăn Kiến"

#. An infant Hornteater. When it
#. becomes older, it grows horns
#. and a hard carapace over its
#. back.
msgctxt "#115 desc"
msgid ""
"ホーンティータの幼獣。\n"
"成長すると巨大な角が生え、\n"
"硬い甲殻に覆われる。"
msgstr ""
"Con non của Thú Sừng Ăn Kiến.\n"
"Khi trưởng thành, chúng sẽ\n"
"mọc sừng và hình thành một\n"
"lớp vỏ cứng sau lưng."

#. Brutal Infant
msgctxt "#116 name"
msgid "コブルート"
msgstr "Thú Nhi Tàn Bạo"

#. An infant buffalo monster. 
#. Gains the ability to move
#. freely within hours of birth,
#. joining the herd on its own.
msgctxt "#116 desc"
msgid ""
"幼少期の牛型魔獣。\n"
"生まれて数時間で立ち上がり\n"
"群れの移動に自力でついていく。"
msgstr ""
"Con non của ma thú trâu.\n"
"Ngay khi chào đời, nó đã có thể\n"
"di chuyển cùng bầy đàn và\n"
"hoạt động suốt nhiều giờ."

#. Infant Drango
msgctxt "#117 name"
msgid "コドモドランゴ"
msgstr "Drango Non"

#. A monster that resembles the
#. dragons in legend. Small in
#. size, but capable of turning
#. a wide area to ash.
msgctxt "#117 desc"
msgid ""
"伝承の“竜”によく似た魔獣。\n"
"体は小さいが火の息を吹き、\n"
"あたりを焼け野原にするだけの\n"
"ポテンシャルを秘めている。"
msgstr ""
"Ma thú có hình tượng rất giống\n"
"với loài rồng trong truyền thuyết.\n"
"Tuy còn nhỏ, nhưng nó có thể\n"
"phun lửa thiêu rụi cả một vùng."

#. Zoro-Agruga
msgctxt "#118 name"
msgid "ゾロ・アグルーガ"
msgstr "Zoro-Agruga"

#. A dragon-like fiend from the
#. Dark Ages made of bone. Sprays
#. dark breath and has the power
#. to shake space itself.
msgctxt "#118 desc"
msgid ""
"無数の骨によって竜の姿を成す\n"
"暗黒時代の伝承にある魔物。\n"
"闇の息吹を吐き、空間を揺らす\n"
"絶大な力を持つとされる。"
msgstr ""
"Ma thú huyền thoại dưới dạng\n"
"xương thuộc Thời Kỳ Tăm Tối.\n"
"Nó phun ra hơi thở bóng đêm\n"
"và làm rung chuyển không gian."

#. Zwordar
msgctxt "#119 name"
msgid "ズウォーダー"
msgstr "Zwordar"

#. A ferocious bird of prey.
#. Pulls prey upwards with a
#. whirlwind, and then catches
#. it with its sharp talons.
msgctxt "#119 desc"
msgid ""
"獰猛な猛禽型の魔獣。\n"
"竜巻を起こして獲物を巻き上げ、\n"
"鋭い爪で鷲掴みにする。"
msgstr ""
"Ma thú săn mồi hung hãn.\n"
"Nó tạo ra cơn lốc để nâng\n"
"con mồi lên và tóm lấy\n"
"chúng bằng bộ vuốt sắc bén."

#. Great Grouse
msgctxt "#120 name"
msgid "オオライチョウ"
msgstr "Đại Lôi Điểu"

#. A giant avian monster that
#. lives in mountainous regions.
#. Creates whirlwinds which tear
#. living things to shreds.
msgctxt "#120 desc"
msgid ""
"山岳地帯を住処とする\n"
"巨大な鳥型魔獣。\n"
"翼によって起こされる竜巻は\n"
"生物を八つ裂きにする。"
msgstr ""
"Ma thú chim khổng lồ trú ngụ\n"
"tại những vùng núi cao.\n"
"Cơn lốc được tạo ra từ đôi cánh\n"
"có thể băm nhỏ mọi sinh vật."

#. Zwordar
msgctxt "#121 name"
msgid "ズウォーダー"
msgstr "Zwordar"

#. A ferocious bird of prey.
#. Pulls prey upwards with a
#. whirlwind, and then catches
#. it with its sharp talons.
msgctxt "#121 desc"
msgid ""
"獰猛な猛禽型の魔獣。\n"
"竜巻を起こして獲物を巻き上げ、\n"
"鋭い爪で鷲掴みにする。"
msgstr ""
"Ma thú săn mồi hung hãn.\n"
"Nó tạo ra cơn lốc để nâng\n"
"con mồi lên và tóm lấy\n"
"chúng bằng bộ vuốt sắc bén."

#. Vampiric Thorn
msgctxt "#122 name"
msgid "ヴァンパイアソーン"
msgstr "Gai Hấp Huyết"

#. A strange plant monster. 
#. Usually lurks underground,
#. draining its prey of every
#. last drop of blood.
msgctxt "#122 desc"
msgid ""
"異形の植物型魔獣。\n"
"普段は地中に潜んでおり、\n"
"捕らえた獲物の血を\n"
"一滴残らず飲み干す。"
msgstr ""
"Ma thú thực vật kỳ dị.\n"
"Chúng thường ẩn dưới\n"
"lòng đất, tóm lấy con mồi\n"
"và hút cạn máu."

#. Greedy Reaper
msgctxt "#123 name"
msgid "グリードリーパー"
msgstr "Hấp Huyết Tham Lam"

#. A worm monster that lurks
#. underground. Its body is
#. covered in tough armor, and
#. it drains HP from its prey.
msgctxt "#123 desc"
msgid ""
"地中に潜む環形魔獣。\n"
"硬い装甲に覆われた体を持ち、\n"
"噛み付いた獲物のHPを吸収する。"
msgstr ""
"Ma thú ẩn mình dưới lòng đất.\n"
"Cơ thể của chúng được bao bọc\n"
"trong một lớp giáp cứng.\n"
"Chúng cắn và hút HP con mồi."

#. Hydra
msgctxt "#124 name"
msgid "タトージャ"
msgstr "Hydra"

#. A serpent monster with many
#. heads, each acting separately.
#. Each head competes to feast on
#. prey, eating even the bones.
msgctxt "#124 desc"
msgid ""
"無数の頭を持つ蛇型魔獣。\n"
"それぞれが知能を持ち、\n"
"取り合うように獲物を貪るため\n"
"あとには骨すら残らない。"
msgstr ""
"Ma thú rắn nhiều đầu.\n"
"Mỗi cái đầu đều có nhận thức\n"
"riêng, chúng xâu xé con mồi\n"
"đến mức không còn gì."

#. Thunder Hydra
msgctxt "#125 name"
msgid "サンダーハイドラ"
msgstr "Hydra Sấm Sét"

#. A serpent fiend with many
#. heads. Sprays lightning 
#. breath by generating 
#. electricity in its body.
msgctxt "#125 desc"
msgid ""
"無数の頭を持つ大蛇の魔物。\n"
"体内で雷を発生させることで\n"
"稲妻のブレスを吐く。"
msgstr ""
"Ma thú rắn nhiều đầu.\n"
"Nó tích điện trong cơ thể\n"
"và phun ra những luồng\n"
"hơi thở sấm sét."

#. Thunder Loach
msgctxt "#126 name"
msgid "サンダーローチ"
msgstr "Lôi Chạch"

#. An infant fish capable of
#. producing electricity with its
#. feelers. It may be young, but
#. it is still deadly.
msgctxt "#126 desc"
msgid ""
"帯電する魚型魔獣の幼生だが、\n"
"触角を使った電撃は侮れない。"
msgstr ""
"Con non của loài cá tích điện.\n"
"Dù chỉ là con non, nhưng vẫn\n"
"không thể xem thường những\n"
"đòn phóng điện từ nó."

#. Grunoja
msgctxt "#127 name"
msgid "グルノージャ"
msgstr "Grunoja"

#. Ruler of Lunaria Nature Park,
#. it attacks those who enter
#. its territory. Smashes all 
#. who oppose it to pieces.
msgctxt "#127 desc"
msgid ""
"縄張りを荒らすものを許さない\n"
"ルナリア自然公園のヌシ。\n"
"その巨体からの凄まじい連打で\n"
"敵を木っ端微塵に叩き潰す。"
msgstr ""
"Kẻ thống trị Công viên.\n"
"Tự nhiên Lunaria\n"
"Bấy kỳ ai xâm phạm lãnh thổ\n"
"đều sẽ bị nghiền nát."

#. Crocodark
msgctxt "#128 name"
msgid "サメゲーター"
msgstr "Cá Mập Sấu"

#. An amphibian monster that 
#. lives near water. Its appetite
#. is ferocious, and its jaw is
#. strong enough to pierce steel.
msgctxt "#128 desc"
msgid ""
"水辺に生息している両棲魔獣。\n"
"鋼鉄さえをも引き千切る顎で\n"
"獰猛な食欲を満たす。"
msgstr ""
"Ma thú lưỡng cư sống\n"
"tại vùng sông nước.\n"
"Bộ hàm của nó có thể\n"
"xé toạc cả sắt thép."

#. Hippogriff
msgctxt "#129 name"
msgid "ヒポグリフ"
msgstr "Bằng Mã"

#. A large bird that hunts on
#. the highlands. Its talons
#. contain deadly poison, and it
#. can spew burning-hot breath.
msgctxt "#129 desc"
msgid ""
"高原の獲物を狙う巨大な怪鳥。\n"
"屍肉に塗れた爪には毒性があり、\n"
"燃え盛る火炎の息まで吐く。"
msgstr ""
"Một loài chim lớn chuyên\n"
"săn mồi trên cao nguyên.\n"
"Chúng sở hữu bộ vuốt\n"
"độc tố và có thể phun lửa."

#. Roc
msgctxt "#130 name"
msgid "ルフ"
msgstr "Roc"

#. A cunning, ferocious bird 
#. that hunts on the mountain
#. path. Freezes its prey before 
#. carrying it back to its nest.
msgctxt "#130 desc"
msgid ""
"山道を行く者をつけ狙う、\n"
"極めて凶暴かつ狡猾な怪鳥。\n"
"氷の息吹で獲物を凍てつかせ、\n"
"巣に持ち帰って保存するという。"
msgstr ""
"Loài quái điểu chuyên\n"
"rình rập trên đường núi.\n"
"Chúng đóng băng con mồi,\n"
"tha về tổ để tích trữ thức ăn."

#. Tri-Attacker R2
msgctxt "#131 name"
msgid "トライアタッカーR2"
msgstr "Tri-Attacker R2"

#. A patrol archaism released by
#. the Imperial Liberation Front.
#. Very mobile, and capable of
#. machine gun and missile fire.
msgctxt "#131 desc"
msgid ""
"帝国解放戦線が放った\n"
"制圧用小型人形兵器。\n"
"小回りの利く哨戒タイプで\n"
"機銃やミサイルも搭載している。"
msgstr ""
"Binh khí hình nhân do Trận\n"
"Tuyến Giải Phóng tung ra.\n"
"Chúng rất cơ động, được trang\n"
"bị súng máy lẫn tên lửa."

#. Tri-Attacker HG
msgctxt "#132 name"
msgid "トライアタッカーHG"
msgstr "Tri-Attacker HG"

#. A patrol archaism released by
#. the Imperial Liberation Front.
#. Reduces foes' movement and
#. defense with electromagnetism.
msgctxt "#132 desc"
msgid ""
"帝国解放戦線が放った\n"
"哨戒タイプの小型人形兵器。\n"
"広範囲に電磁波を拡散し\n"
"敵の防御力と行動力を削ぐ。"
msgstr ""
"Binh khí hình nhân do Trận\n"
"Tuyến Giải Phóng tung ra.\n"
"Chúng làm suy giảm phòng ngự\n"
"và tốc độ của kẻ địch."

#. Tri-Attacker R2
msgctxt "#133 name"
msgid "トライアタッカーR2"
msgstr "Tri-Attacker R2"

#. A patrol archaism released by
#. the Imperial Liberation Front.
#. Very mobile, and capable of
#. machine gun and missile fire.
msgctxt "#133 desc"
msgid ""
"帝国解放戦線が放った\n"
"制圧用小型人形兵器。\n"
"小回りの利く哨戒タイプで\n"
"機銃やミサイルも搭載している。"
msgstr ""
"Binh khí hình nhân do Trận\n"
"Tuyến Giải Phóng tung ra.\n"
"Chúng rất cơ động, được trang\n"
"bị súng máy lẫn tên lửa."

#. Tri-Attacker HG
msgctxt "#134 name"
msgid "トライアタッカーHG"
msgstr "Tri-Attacker HG"

#. A patrol archaism released by
#. the Imperial Liberation Front.
#. Reduces foes' movement and
#. defense with electromagnetism.
msgctxt "#134 desc"
msgid ""
"帝国解放戦線が放った\n"
"哨戒タイプの小型人形兵器。\n"
"広範囲に電磁波を拡散し\n"
"敵の防御力と行動力を削ぐ。"
msgstr ""
"Binh khí hình nhân do Trận\n"
"Tuyến Giải Phóng tung ra.\n"
"Chúng làm suy giảm phòng ngự\n"
"và tốc độ của kẻ địch."

#. Tri-Attacker R2
msgctxt "#135 name"
msgid "トライアタッカーR2"
msgstr "Tri-Attacker R2"

#. A patrol archaism released by
#. the Imperial Liberation Front.
#. Very mobile, and capable of
#. machine gun and missile fire.
msgctxt "#135 desc"
msgid ""
"帝国解放戦線が放った\n"
"制圧用小型人形兵器。\n"
"小回りの利く哨戒タイプで\n"
"機銃やミサイルも搭載している。"
msgstr ""
"Binh khí hình nhân do Trận\n"
"Tuyến Giải Phóng tung ra.\n"
"Chúng rất cơ động, được trang\n"
"bị súng máy lẫn tên lửa."

#. Tri-Attacker HG
msgctxt "#136 name"
msgid "トライアタッカーHG"
msgstr "Tri-Attacker HG"

#. A patrol archaism released by
#. the Imperial Liberation Front.
#. Reduces foes' movement and
#. defense with electromagnetism.
msgctxt "#136 desc"
msgid ""
"帝国解放戦線が放った\n"
"哨戒タイプの小型人形兵器。\n"
"広範囲に電磁波を拡散し\n"
"敵の防御力と行動力を削ぐ。"
msgstr ""
"Binh khí hình nhân do Trận\n"
"Tuyến Giải Phóng tung ra.\n"
"Chúng làm suy giảm phòng ngự\n"
"và tốc độ của kẻ địch."

#. Unsurtr
msgctxt "#137 name"
msgid "アンスルト"
msgstr "Unsurtr"

#. A giant beast with a body
#. covered in ice. Freezes
#. all with frigid blizzards.
msgctxt "#137 desc"
msgid ""
"全身が氷に包まれた巨大獣。\n"
"凍える吹雪を発生させて\n"
"あらゆるものを凍てつかせる。"
msgstr ""
"Quái thú khổng lồ được\n"
"bao bọc trong băng giá.\n"
"Nó tạo ra bão buyết đóng\n"
"băng tất thảy mọi thứ."

#. Durgnessa
msgctxt "#138 name"
msgid "ドゥルグネッサ"
msgstr "Durgnessa"

#. A massive, mountain-like
#. fiend. Being trampled by
#. its immense weight is enough
#. to crush anything.
msgctxt "#138 desc"
msgid ""
"山のような巨躯を誇る魔物。\n"
"超重量にまかせた踏み付けは\n"
"あらゆるものを潰してしまう。"
msgstr ""
"Ma vật với kích cỡ không\n"
"thua kém gì một ngọn núi.\n"
"Nó dựa vào trọng lượng để\n"
"nghiền nát mọi thứ."

#. Dancing Owl
msgctxt "#139 name"
msgid "ダンシングオゥル"
msgstr "Cú Nhảy"

#. Avian monster with beautiful
#. wings. Those who witness its
#. strange dance suffer various
#. status abnormalities.
msgctxt "#139 desc"
msgid ""
"艶やかな羽根を持つ鳥型魔獣。\n"
"その不思議な踊りを見たものは\n"
"様々な状態異常に陥る。"
msgstr ""
"Ma thú chim với đôi cánh sặc sỡ.\n"
"Những kẻ trông thấy điệu nhảy\n"
"của nó sẽ phải hứng chịu những\n"
"trạng thái bất ổn."

#. Gespard
msgctxt "#140 name"
msgid "ゲシュパード"
msgstr "Gespard"

#. An assault archaism. Can deal
#. with foes in a wide area due
#. to its elastic arms and 
#. devastating main cannon.
msgctxt "#140 desc"
msgid ""
"突撃型の人形兵器。\n"
"伸縮自在のアームと\n"
"高い威力を誇る主砲を備え\n"
"広範囲の敵に対応できる。"
msgstr ""
"Binh khí hình nhân xung kích.\n"
"Chúng sở hữu cánh tay máy\n"
"linh hoạt cùng pháo chính\n"
"mang sức công phá vượt trội."

#. Gespard G
msgctxt "#141 name"
msgid "ゲシュパードＧ"
msgstr "Gespard G"

#. An assault archaism made 
#. by Ouroboros. Charges 
#. its enemies and unleashes 
#. wide reaching destruction.
msgctxt "#141 desc"
msgid ""
"謎の《結社》の突撃型人形兵器。\n"
"途轍もない突破力を生かして\n"
"敵陣に突っ込み、\n"
"広範囲攻撃で一気に殲滅する。"
msgstr ""
"Binh khí hình nhân được\n"
"chế tạo bởi Tổ Chức.\n"
"Chúng lao thẳng vào kẻ địch\n"
"và càn quét mọi thứ."

#. Moon Mole
msgctxt "#142 name"
msgid "ツキノワモグラ"
msgstr "Chuột Trăng"

#. A mole monster that lives 
#. in the sealed mine shaft. 
#. Its claws are ideal both for 
#. digging and cutting prey.
msgctxt "#142 desc"
msgid ""
"閉鎖された坑道に棲みついた\n"
"土竜型の魔獣。\n"
"鋭い爪は土を掘り進む以外に、\n"
"獲物を切り刻むのにも使う。"
msgstr ""
"Ma thú chuột chũi sống trong\n"
"hầm mỏ bị phong tỏa.\n"
"Ngoài đào đất, chúng còn sử\n"
"dụng móng để xé xác con mồi."

#. Jelly Shroom
msgctxt "#143 name"
msgid "クラゲダケ"
msgstr "Sứa Nấm"

#. A massively swollen fungus.
#. Paralyzes organisms that
#. approach it and slowly feeds
#. on their nutrients.
msgctxt "#143 desc"
msgid ""
"空中を漂う肥大化した菌類。\n"
"近づいてくる生物を麻痺させて\n"
"ゆっくりと養分を吸いとる。"
msgstr ""
"Chủng nấm khổng lồ lơ lửng.\n"
"Nó sẽ làm tê liệt sinh vật đến\n"
"gần và hút chầm chậm hút lấy\n"
"dinh dưỡng từ chúng."

#. Rose Shroom
msgctxt "#144 name"
msgid "ロゼリアキノコ"
msgstr "Nấm Hoa Hồng"

#. A mollusk formed from several
#. pink spores. Possesses a 
#. powerful neurotoxin. Touching
#. it causes paralysis.
msgctxt "#144 desc"
msgid ""
"ピンクの胞子が集合して\n"
"生まれた軟体魔獣。\n"
"強い神経毒を持ち、触れると\n"
"麻痺した上に養分を吸われる。"
msgstr ""
"Ma thú thân mềm hình thành\n"
"từ bào tử nấm hồng.\n"
"Chất động thần kinh của chúng\n"
"gây tê liệt mạnh khi chạm vào."

#. Gold Fungus
msgctxt "#145 name"
msgid "ゴルドフングス"
msgstr "Nấm Vàng"

#. A spore monster that became 
#. massively enlarged due to 
#. eating high-quality ore. The 
#. reason the shaft was closed.
msgctxt "#145 desc"
msgid ""
"質のいい鉱物を食べ続けて\n"
"超巨大に成長した胞子魔獣。\n"
"坑道の一つを封鎖させる\n"
"きっかけを作った。"
msgstr ""
"Ma thú bào tử đã phát triển\n"
"thành thể khổng lồ.\n"
"Đây cũng là một trong những\n"
"lý do mà hầm mỏ bị phong tỏa."

#. Bomb Spider
msgctxt "#146 name"
msgid "ボムスパイダー"
msgstr "Nhện Bom"

#. An arthropod monster that eats
#. wreckage left by explosions. 
#. Detonates the poison sac on 
#. its back if it senses danger.
msgctxt "#146 desc"
msgid ""
"発破の残骸を長きに渡って\n"
"主食としてきた節足魔獣。\n"
"危険を感じると毒液の詰まった\n"
"背中の気嚢を破裂させる。"
msgstr ""
"Ma thú chân đốt ăn những\n"
"mảnh vỡ còn sót lại sau vụ nổ.\n"
"Khi cảm thấy nguy hiểm, chúng\n"
"sẽ giải phóng chất độc trên lưng."

#. Lantern Spider
msgctxt "#147 name"
msgid "アンドングモ"
msgstr "Nhện Đèn"

#. An arthropod monster with an
#. air sac that gives off a pale
#. light on its back. This sac
#. contains a poisonous liquid.
msgctxt "#147 desc"
msgid ""
"青白くぼんやりと発光する\n"
"不気味な気嚢を持つ節足魔獣。\n"
"毒性の強い液体が詰まっており\n"
"不用意に近づいてはいけない。"
msgstr ""
"Ma thú chân đốt sở hữu túi khí\n"
"phát sáng trắng xanh kỳ lạ.\n"
"Túi khí này tích tụ chất độc\n"
"cực mạnh."

#. Ostrich
msgctxt "#148 name"
msgid "ダッチョーノ"
msgstr "Đà Đểu"

#. A strange bird that races
#. around on non-paved 
#. plains. Its breath allows 
#. it to petrify its prey.
msgctxt "#148 desc"
msgid ""
"舗装されてない草原を\n"
"縦横無尽に駆け回る怪鳥。\n"
"その息吹で獲物を石化させる。"
msgstr ""
"Loài chim dị liên tục chạy nhảy\n"
"trên đồng cỏ cao nguyên.\n"
"Hơi thở của chúng có thể\n"
"hóa đá con mồi."

#. Stony Croaker
msgctxt "#149 name"
msgid "イシゲェロ"
msgstr "Ếch Đá Ộp Ộp"

#. A large, frog-like monster with
#. skin like rock. Draws in prey
#. with its long tongue and 
#. restrains it with mucus.
msgctxt "#149 desc"
msgid ""
"石のような硬い皮膚を持つ\n"
"巨大な蛙型魔獣。\n"
"長い舌で遠くの獲物を引き寄せ、\n"
"粘液を吐いて自由を奪う。"
msgstr ""
"Ma thú ếch khổng lồ\n"
"sở hữu lớp da cứng như đá.\n"
"Nó dùng lưỡi để kéo con mồi\n"
"và khống chế chúng."

#. Rocky Croaker
msgctxt "#150 name"
msgid "オオイシゲェロ"
msgstr "Ếch Đá Siêu To"

#. A large, frog-like monster. 
#. Its skin is as hard as iron,
#. due to all the stones it eats.
msgctxt "#150 desc"
msgid ""
"巨大な蛙型の魔獣。\n"
"岩石を長い舌で日常的に\n"
"食べているためか、\n"
"皮膚は鉄の鎧のように硬い。"
msgstr ""
"Ma thú ếch khổng lồ.\n"
"Do ăn đá tảng thay cơm,\n"
"nên da của nó đã trở nên\n"
"cứng như sắt."

#. Zephyranthes
msgctxt "#151 name"
msgid "ゼフィランサス"
msgstr "Zephyranthes"

#. A large archaism designed for
#. defending strongholds. Reduces
#. enemy numbers with lasers and
#. immense firepower.
msgctxt "#151 desc"
msgid ""
"拠点防衛用の大型人形兵器。\n"
"特殊なレーザーで敵戦力を削り、\n"
"搭載した大火力で攻撃してくる。"
msgstr ""
"Binh khí hình nhân chuyên\n"
"dùng để phòng thủ cứ điểm.\n"
"Nó vô hiệu kẻ địch bằng tia\n"
"laser và hỏa lực bất tận."

#. G-Zephyranthes
msgctxt "#152 name"
msgid "Ｇ・ゼフィランサス"
msgstr "G-Zephyranthes"

#. A large, golden archaism. 
#. Supports C with powerful 
#. laser beams and wide-range
#. shockwaves.
msgctxt "#152 desc"
msgid ""
"金色の大型人形兵器。\n"
"強力なサイクロンレーザーと\n"
"広範囲を攻撃する衝撃波で\n"
"《Ｃ》を護衛する。"
msgstr ""
"Binh khí hình nhân hoàng kim.\n"
"Nó hỗ trợ C bằng các đòn sóng\n"
"kích diện rộng và tia laser\n"
"áp đảo."

#. B-Zephyranthes
msgctxt "#153 name"
msgid "Ｂ・ゼフィランサス"
msgstr "B-Zephyranthes"

#. A large archaism designed 
#. for defending strongholds. 
#. This improved blue model 
#. has incredible firepower.
msgctxt "#153 desc"
msgid ""
"帝国解放戦線が放った\n"
"拠点防衛用の大型人形兵器。\n"
"改良された青色の機体で\n"
"凄まじい火力を誇る。"
msgstr ""
"Binh khí hình nhân chuyên\n"
"dùng để phòng thủ cứ điểm.\n"
"Bản cải tiến này sở hữu\n"
"hỏa lực khôn lường."

#. R-Zephyranthes
msgctxt "#154 name"
msgid "Ｒ・ゼフィランサス"
msgstr "R-Zephyranthes"

#. A red archaism strengthened
#. to support the ILF's leaders.
#. Even more powerful and deadly
#. than standard models.
msgctxt "#154 desc"
msgid ""
"真紅の大型人形兵器。\n"
"幹部護衛用に改良が施された、\n"
"より高性能・高火力の機体。"
msgstr ""
"Binh khí hình nhân đỏ thẫm.\n"
"Nó được cải tiến về nhiều mặt,\n"
"bao gồm phòng ngự và hỏa\n"
"lực chết người."

#. Zephyranthes
msgctxt "#155 name"
msgid "ゼフィランサス"
msgstr "Zephyranthes"

#. A large archaism designed for
#. defending strongholds. Reduces
#. enemy numbers with lasers and
#. immense firepower.
msgctxt "#155 desc"
msgid ""
"拠点防衛用の大型人形兵器。\n"
"特殊なレーザーで敵戦力を削り、\n"
"搭載した大火力で攻撃してくる。"
msgstr ""
"Binh khí hình nhân chuyên\n"
"dùng để phòng thủ cứ điểm.\n"
"Nó vô hiệu kẻ địch bằng tia\n"
"laser và hỏa lực bất tận."

#. Combat Shell α
msgctxt "#156 name"
msgid "戦術殻α"
msgstr "Vỏ Chiến Thuật α"

#.A combat dummy set up 
#.for practical exams. Feels 
#.strange to the touch, and 
#.fights as programmed.
msgctxt "#156 desc"
msgid ""
"実技テスト用の戦闘傀儡。\n"
"不思議な質感をしており、\n"
"プログラムされた攻撃を行う。"
msgstr ""
"Cuối cùng mới có một bộ anime\n"
"mà nhân vật chính đúng chuẩn\n"
"hình mẫu lý tưởng của tao. \n"
"- Ayanokouji"

#. Combat Shell β
msgctxt "#157 name"
msgid "戦術殻β"
msgstr "Vỏ Chiến Thuật β"

#. A combat dummy that operates
#. by some unknown means. Its
#. change of form allows it to
#. use more powerful attacks.
msgctxt "#157 desc"
msgid ""
"謎の機構で動く戦闘傀儡。\n"
"変形したことでより強力な\n"
"攻撃を行えるようになった。"
msgstr ""
"Rối chiến đấu vận hành\n"
"bằng cơ chế bí ẩn.\n"
"Sau khi chuyển đổi hình thái,\n"
"nó đã trở nên mạnh hơn."

#. Combat Shell γ
msgctxt "#158 name"
msgid "戦術殻γ"
msgstr "戦術殻 γ"

#. A combat dummy made of a 
#. mysterious metal. Has high
#.attack and defense power 
#.to simulate real battle.
msgctxt "#158 desc"
msgid ""
"不思議な金属製の戦闘傀儡。\n"
"実戦レベルの戦闘を想定した\n"
"高い防御と攻撃を誇る形態。"
msgstr ""
"Rối chiến đấu vận hành\n"
"bằng cơ chế bí ẩn.\n"
"Nó được thiết kế cho các tình\n"
"huống chiến đấu thực tế."

#. Combat Shell β
msgctxt "#159 name"
msgid "戦術殻β"
msgstr "Vỏ Chiến Thuật β"

#. A combat dummy that operates
#. by some unknown means. Its
#. change of form allows it to
#. use more powerful attacks.
msgctxt "#159 desc"
msgid ""
"謎の機構で動く戦闘傀儡。\n"
"変形したことでより強力な\n"
"攻撃を行えるようになった。"
msgstr ""
"Rối chiến đấu vận hành\n"
"bằng cơ chế bí ẩn.\n"
"Sau khi chuyển đổi hình thái,\n"
"nó đã trở nên mạnh hơn."

#. Winged Snake
msgctxt "#160 name"
msgid "ウィングスネイク"
msgstr "Rắn Bay"

#. A winged snake that flies
#. around on the Nord Highlands.
#. The people of Nord fear the
#. poison in its fangs.
msgctxt "#160 desc"
msgid ""
"ノルド高原を飛び回る\n"
"翼の生えた蛇型魔獣。\n"
"その牙には毒があり\n"
"集落の人間も注意している。"
msgstr ""
"Ma thú rắn có cắn sinh sống\n"
"tại Cao Nguyên Nord.\n"
"Người của bộ lạc rất cẩn trọng\n"
"trước cặp nanh độc của nó."

#. Diving Ananta
msgctxt "#161 name"
msgid "デプスアナンタ"
msgstr "Ananta Vực Thẳm"

#. A serpent monster containing
#. deadly poison. Plunges its
#. fangs into its prey from the
#. air using its bat-like wings.
msgctxt "#161 desc"
msgid ""
"猛毒を持つ蛇型魔獣。\n"
"蝙蝠のような羽根を用いて\n"
"中空から牙を突き立てる。"
msgstr ""
"Ma thú rắn có độc chết người.\n"
"Chúng dang chiếc cánh và lao\n"
"xuống cắm phập răng nanh\n"
"vào kẻ địch."

#. Stone Golem
msgctxt "#162 name"
msgid "ストーンゴーレム"
msgstr "Golem Đá"

#. A golem created from stone
#. which appears in Erebonian
#. legends. Can cause earthquakes
#. by stamping on the ground.
msgctxt "#162 desc"
msgid ""
"帝国の伝承にも存在する、\n"
"岩石から生まれたゴーレム。\n"
"大地を踏みつけて巨大な地震を\n"
"起こすことが出来る。"
msgstr ""
"Golem truyền thuyết từng xuất\n"
"hiện trong sử sách của Đế quốc.\n"
"Nó có thể tạo ra những cơn địa\n"
"chấn kinh hoàng."

#. Steel Golem
msgctxt "#163 name"
msgid "アイアンゴーレム"
msgstr "Golem Sắt"

#. A magical golem born by
#. giving life to steel. Causes 
#. powerful earthquakes at will.
msgctxt "#163 desc"
msgid ""
"鋼鉄に生命が吹き込まれ、\n"
"生み出された魔導のゴーレム。\n"
"地盤を揺るがせるほどの\n"
"大激震を引き起こす。"
msgstr ""
"Golem dẫn lực sinh ra từ sắt\n"
"thép được trao sự sống.\n"
"Nó tạo ra cơn đại địa chấn\n"
"làm rung chuyển một vùng."

#. Dissolution Slug
msgctxt "#164 name"
msgid "ディゾルスラッグ"
msgstr "Sên Ăn Mòn"

#. A mollusk monster with
#. countless feelers. Uses 
#. acid stored in its body to 
#. dissolve and devour its prey.
msgctxt "#164 desc"
msgid ""
"無数の触角を持つ軟体魔獣。\n"
"強酸性の液体を蓄えており\n"
"獲物をじわじわ溶かして食べる。"
msgstr ""
"Ma thú với vô số xúc tu.\n"
"Chúng dùng axit để hòa tan\n"
"và ngấu nghiến con mồi."

#. Diglem
msgctxt "#165 name"
msgid "ディグレム"
msgstr "Diglem"

#. A stone statue allowed to move
#. because of the strange force
#. active in the quarry. Lowers
#. foes' abilities with beams.
msgctxt "#165 desc"
msgid ""
"不可思議な“場”の影響で\n"
"動き出した太古の石像。\n"
"宝玉から身体能力を低下させる\n"
"不気味な光線を放つ。"
msgstr ""
"Bức tượng cổ thức tỉnh dưới\n"
"tác động từ môi trường bí ẩn.\n"
"Nó phóng ra luồng sáng\n"
"làm suy yếu kẻ địch."

#. Star Lambda
msgctxt "#166 name"
msgid "スターラムダ"
msgstr "Sao Lambda"

#. A stone statue granted life by
#. a mysterious power. Lowers 
#. the abilities of its foes with
#. cursed beams of light.
msgctxt "#166 desc"
msgid ""
"謎の力で生命を宿した石像。\n"
"呪いの力が込められた光線で\n"
"敵対者の身体能力を低下させる。"
msgstr ""
"Bức tượng được trao sự sống\n"
"bởi thứ sức mạnh bí ẩn.\n"
"Chúng sử dụng tia sáng nguyền\n"
"rủa để làm suy yếu kẻ địch."

#. Stone Stalker
msgctxt "#167 name"
msgid "ストークス"
msgstr "Đá Theo Đuổi"

#. A four-legged stone creature.
#. When it sees an enemy, it
#. approaches them, then attacks
#. with its weight from above.
msgctxt "#167 desc"
msgid ""
"四本足で歩き回る石の人形。\n"
"敵を発見すると近づいていき、\n"
"その重量を頭上から叩きつける。"
msgstr ""
"Sinh vật đá bốn chân.\n"
"Chúng sẽ tiếp cận kẻ địch khi\n"
"phát hiện và dùng trọng lượng\n"
"của mình để giáng xuống từ cao."

#. Ghoul Frog
msgctxt "#168 name"
msgid "グールフロッグ"
msgstr "Cóc Ngạ Quỷ"

#. A mass of dead monsters. 
#. Has exceptional regenerative
#. abilities.
msgctxt "#168 desc"
msgid ""
"魔獣の屍肉の集合体。\n"
"自己再生能力に優れている。"
msgstr ""
"Tập hợp xác chết của\n"
"vô số ma thú.\n"
"Sở hữu khả năng tái tạo\n"
"siêu việt."

#. Polyjelly
msgctxt "#169 name"
msgid "ポリプルン"
msgstr "Sứa Đa Sắc"

#. A floating spore creature from
#. another world. Those who touch
#. it turn to stone.
msgctxt "#169 desc"
msgid ""
"宙を漂う異界の胞子生物。\n"
"触れたものを石と化してしまう。"
msgstr ""
"Sinh vật bào tử đến từ\n"
"thế giới khác.\n"
"Những kẻ chạm vào nó\n"
"sẽ bị hóa đá."

#. Hell Rabbit
msgctxt "#170 name"
msgid "ヘルラビット"
msgstr "Thỏ Địa Ngục"

#. A monster said to have come
#. from the underworld. Those
#. pierced by its spines are 
#. believed to lose their souls.
msgctxt "#170 desc"
msgid ""
"冥界の獣と伝えられる魔獣。\n"
"トゲを突き立てられた者は\n"
"たちまちその魂を失うという。"
msgstr ""
"Ma thú đến từ minh giới.\n"
"Kẻ nào bị những chiếc gai\n"
"của nó đâm phải sẽ bị\n"
"tước đi linh hồn."

#. Ramon
msgctxt "#171 name"
msgid "ラモン"
msgstr ""

#. A fiend with black fur, said
#. to be a servant of Gehenna.
#. Appears before those who have
#. little time left to live.
msgctxt "#171 desc"
msgid ""
"黒いたてがみを持つ魔物。\n"
"煉獄の使いと言い伝えられ、\n"
"死期が近づく者の前に現れる。"
msgstr ""

#. Glaceron
msgctxt "#172 name"
msgid "グラケロン"
msgstr ""

#. A large turtle with a stone-
#. like carapace. Sprays rocks
#. from its back to repel foes.
msgctxt "#172 desc"
msgid ""
"岩のような甲羅を持つ巨亀。\n"
"背中から無数の岩石を\n"
"噴出して外敵を退ける。"
msgstr ""

#. Lunar Bee
msgctxt "#173 name"
msgid "ムーンザビー"
msgstr ""

#. A bee-like fiend capable
#. of crossing dimensions. Its
#. highly lethal poison makes it
#. incredibly dangerous.
msgctxt "#173 desc"
msgid ""
"異次元を飛ぶ蜂の魔物。\n"
"凄まじく致死性の高い\n"
"猛毒を持っており、非常に危険。"
msgstr ""

#. Purple Ooze
msgctxt "#174 name"
msgid "パープルウーズ"
msgstr ""

#. A strange lifeform from
#. another world. Can drain large
#. amounts of HP, EP, and CP,
#. making it a difficult foe.
msgctxt "#174 desc"
msgid ""
"異界より現れた謎の生命体。\n"
"大量のHP、EP、CPを吸収する\n"
"厄介な能力を備えている。"
msgstr ""

#. Hinomikoto
msgctxt "#175 name"
msgid "ヒノミコト"
msgstr ""

#. A beast with boiling hot 
#. blood. Deified by some.
#. Charges foes with its burning
#. horns and uses fire arts.
msgctxt "#175 desc"
msgid ""
"灼熱の血が流れると言われ、\n"
"神聖視されることもある獣。\n"
"燃え盛る角で突進攻撃を行い、\n"
"火のアーツまで使用する。"
msgstr ""

#. Rup Kamuy
msgctxt "#176 name"
msgid "ルプカムイ"
msgstr ""

#. A beast that roams places
#. that are extremely cold. Said
#. to rule over ice and snow. Its
#. antlers freeze foes on contact.
msgctxt "#176 desc"
msgid ""
"極寒の地を渡り歩く獣。\n"
"氷雪を司ると言い伝えられ、\n"
"枝分かれした角に触れると\n"
"骨の髄まで凍りつく。"
msgstr ""

#. Minos Demon
msgctxt "#177 name"
msgid "ミノスデーモン"
msgstr ""

#. A powerful, two-horned, evil
#. creature. Obscures foes' 
#. vision with dark breath and
#. then pulverizes them.
msgctxt "#177 desc"
msgid ""
"強靭な膂力を誇る２本角の悪鬼。\n"
"暗闇の息吹で視界を奪い、\n"
"恐怖に怯える獲物を叩き潰す。"
msgstr ""

#. Minos Demon
msgctxt "#178 name"
msgid "ミノスデーモン"
msgstr ""

#. A powerful, two-horned, evil
#. creature. Obscures foes' 
#. vision with dark breath and
#. then pulverizes them.
msgctxt "#178 desc"
msgid ""
"強靭な膂力を誇る２本角の悪鬼。\n"
"暗闇の息吹で視界を奪い、\n"
"恐怖に怯える獲物を叩き潰す。"
msgstr ""

#. Surtr
msgctxt "#179 name"
msgid "スルト"
msgstr ""

#. A demi-human fiend that
#. governs fire. Its sword is
#. made of fire so hot, it can
#. boil steel.
msgctxt "#179 desc"
msgid ""
"炎を司る亜人の魔物。\n"
"超高熱の火で作り出した剣は\n"
"鋼鉄すら沸騰させるほど。"
msgstr ""

#. Ashen Fragment
msgctxt "#180 name"
msgid "ピースオブパワー"
msgstr ""

#. Fragment of the Ashen Power.
#. Lulls would-be intruders of
#. the realm to sleep, where they
#. experience nightmares.
msgctxt "#180 desc"
msgid ""
"“灰色のチカラ”の断片。\n"
"領域に侵入した者たちを\n"
"悪夢へと誘う。"
msgstr ""

#. Loa Erebonius
msgctxt "#181 name"
msgid "ロア・エレボニウス"
msgstr ""

#. A shadow of the Great Power
#. which appeared on the 
#. Otherworldly Battlefield.
#. Carries out the Final Trial.
msgctxt "#181 desc"
msgid ""
"異界の戦場に顕現した\n"
"“巨いなる力”の影。\n"
"その圧倒的な存在を以って\n"
"『最後の試し』を執行する。"
msgstr ""

#. Patrick
msgctxt "#182 name"
msgid "パトリック"
msgstr ""

#. Third son of Marquis Hyarms.
#. Exceptionally skilled with a
#. sword thanks to his high-
#. quality education.
msgctxt "#182 desc"
msgid ""
"四大名門ハイアームズ家の三男。\n"
"幼少より受けた英才教育により\n"
"侮れない剣の実力を備える。"
msgstr ""

#. C
msgctxt "#183 name"
msgid "《Ｃ》"
msgstr ""

#. A mysterious masked man who
#. leads the terrorists. Wields
#. a double saber with immense
#. skill, using varied attacks.
msgctxt "#183 desc"
msgid ""
"テロリストを率いる、\n"
"謎に包まれた仮面の男。\n"
"双刃剣を巧みに操り\n"
"数々の技を繰り出す。"
msgstr ""

#. C
msgctxt "#184 name"
msgid "《Ｃ》"
msgstr ""

#. An elderly butler who serves
#. Viscount Arseid. Serves as 
#. acting master of the Arseid
#. school.
msgctxt "#184 desc"
msgid ""
#. A mysterious masked man who
#. leads the terrorists. Wields
#. a double saber with immense
#. skill, using varied attacks.
msgstr ""

#. G (Gideon)
msgctxt "#185 name"
msgid "Ｇ－ギデオン"
msgstr ""

#. A man belonging to an unknown
#. organization who hired the
#. jaeger dropouts. Supports
#. allies with high-level arts.
msgctxt "#185 desc"
msgid ""
"何らかの組織に身を置く\n"
"猟兵崩れたちの雇い主。\n"
"拳銃と高位アーツを操って\n"
"後方からの支援攻撃を行う。"
msgstr ""

#. S (Scarlet)
msgctxt "#186 name"
msgid "Ｓ－スカーレット"
msgstr ""

#. A bewitching Imperial 
#. Liberation Front executive.
#. Torments and slaughters 
#. foes with a templar sword.
msgctxt "#186 desc"
msgid ""
"帝国解放戦線の妖艶なる幹部。\n"
"《法剣》を自由自在に操り、\n"
"敵を翻弄して血祭りにあげる。"
msgstr ""

#. V (Vulcan)
msgctxt "#187 name"
msgid "Ｖ－ヴァルカン"
msgstr ""

#. One of the Imperial Liberation
#. Front's executives. Consumed
#. by hatred as he slaughters
#. foes with a huge gatling gun. 
msgctxt "#187 desc"
msgid ""
"帝国解放戦線の巨漢の幹部。\n"
"憎悪の焔に任せるままに、\n"
"巨大なガトリング砲による\n"
"苛烈な殲滅攻撃を行う。"
msgstr ""

#. Viscount Arseid
msgctxt "#188 name"
msgid "アルゼイド子爵"
msgstr ""

#. The Arseid school's foremost
#. practitioner known as the
#. Radiant Blademaster. Wields a
#. sword with inhuman strength.
msgctxt "#188 desc"
msgid ""
"アルゼイド流の筆頭にして\n"
"《光の剣匠》と呼ばれる剣士。\n"
"宝剣ガランシャールを振るい\n"
"人の域を超えた絶技を繰り出す。"
msgstr ""

#. Butler Klaus
msgctxt "#189 name"
msgid "執事クラウス"
msgstr ""

#. An elderly butler who serves
#. Viscount Arseid. Serves as 
#. acting master of the Arseid
#. school.
msgctxt "#189 desc"
msgid ""
"子爵邸に仕える老執事。\n"
"アルゼイド流の師範代として\n"
"老いを凌駕する剣技を魅せる。"
msgstr ""

#. Fake Park Ranger
msgctxt "#190 name"
msgid "偽管理員"
msgstr ""

#. A fake park ranger at Lunaria
#. Nature Park, responsible for
#. the burglary at the market.
#. Equipped with a rifle.
msgctxt "#190 desc"
msgid ""
"大市で盗難事件を起こした\n"
"ルナリア自然公園の偽管理人。\n"
"ライフルで武装している。"
msgstr ""

#. Noble Student
msgctxt "#191 name"
msgid "貴族生徒"
msgstr ""

#. A member of Class I who spends
#. time around Patrick. Seeks to
#. demonstrate the spirit and
#. dignity of the nobility.
msgctxt "#191 desc"
msgid ""
"パトリックと行動を共にする\n"
"Ⅰ組の貴族生徒。\n"
"その剣で帝国貴族の気風を示す。"
msgstr ""

#. Noble Student
msgctxt "#192 name"
msgid "貴族生徒"
msgstr ""

#. A member of Class I who spends
#. time around Patrick. Seeks to
#. demonstrate the spirit and
#. dignity of the nobility.
msgctxt "#192 desc"
msgid ""
"パトリックと行動を共にする\n"
"Ⅰ組の貴族生徒。\n"
"その剣で帝国貴族の気風を示す。"
msgstr ""

#. Noble Student
msgctxt "#193 name"
msgid "貴族生徒"
msgstr ""

#. A member of Class I who spends
#. time around Patrick. Seeks to
#. demonstrate the spirit and
#. dignity of the nobility.
msgctxt "#193 desc"
msgid ""
"パトリックと行動を共にする\n"
"Ⅰ組の貴族生徒。\n"
"その剣で帝国貴族の気風を示す。"
msgstr ""

#. Alan
msgctxt "#194 name"
msgid "アラン"
msgstr ""

#. A first-year student belonging
#. to the Fencing Club. What he
#. lacks in skill he makes up for
#. with determination.
msgctxt "#194 desc"
msgid ""
"フェンシング部の１年生。\n"
"実力はまだまだ未熟だが\n"
"瞳の奥に強い意志をたたえる。"
msgstr ""

#. P. Army Soldier
msgctxt "#195 name"
msgid "領邦軍兵士"
msgstr ""

#. An elite soldier belonging to
#. the Kreuzen Provincial Army.
#. Well trained and proud.
msgctxt "#195 desc"
msgid ""
"クロイツェン州領邦軍の兵士。\n"
"詰所の精兵として練度は高く、\n"
"誇りを以って侵入者を撃退する。"
msgstr ""

#. P. Army Soldier
msgctxt "#196 name"
msgid "領邦軍兵士"
msgstr ""

#. An elite soldier belonging to
#. the Kreuzen Provincial Army.
#. Well trained and proud.
msgctxt "#196 desc"
msgid ""
"クロイツェン州領邦軍の兵士。\n"
"詰所の精兵として練度は高く、\n"
"誇りを以って侵入者を撃退する。"
msgstr ""

#. Terrorist - Gun
msgctxt "#197 name"
msgid "帝国解放戦線・小銃"
msgstr ""

#. An Imperial Liberation Front
#. member equipped with a small
#. automatic rifle. Believes that
#. the end justifies the means.
msgctxt "#197 desc"
msgid ""
"自動小銃を装備した\n"
"帝国解放戦線のメンバー。\n"
"目的のためならば\n"
"どんな犠牲をも厭わない。"
msgstr ""

#. Terrorist - Sword
msgctxt "#198 name"
msgid "帝国解放戦線・剣"
msgstr ""

#. An Imperial Liberation Front
#. member. Driven by loathing for
#. Chancellor Osborne, and fights
#. using a sword.
msgctxt "#198 desc"
msgid ""
"帝国解放戦線のメンバー。\n"
"《鉄血宰相》への強い憎しみを\n"
"原動力として剣を振るう。"
msgstr ""

#. Terrorist - Gun
msgctxt "#199 name"
msgid "帝国解放戦線・小銃"
msgstr ""

#. An Imperial Liberation Front
#. member equipped with a small
#. automatic rifle. Believes that
#. the end justifies the means.
msgctxt "#199 desc"
msgid ""
"自動小銃を装備した\n"
"帝国解放戦線のメンバー。\n"
"目的のためならば\n"
"どんな犠牲をも厭わない。"
msgstr ""

#. Terrorist - Sword
msgctxt "#200 name"
msgid "帝国解放戦線・剣"
msgstr ""

#. An Imperial Liberation Front
#. member. Driven by loathing for
#. Chancellor Osborne, and fights
#. using a sword.
msgctxt "#200 desc"
msgid ""
"帝国解放戦線のメンバー。\n"
"《鉄血宰相》への強い憎しみを\n"
"原動力として剣を振るう。"
msgstr ""

#. Jaeger Dropout
msgctxt "#201 name"
msgid "猟兵崩れ"
msgstr ""

#. An armed former jaeger hired
#. by Gideon. Lives the lifestyle
#. of a mercenary, risking his
#. life for mira.
msgctxt "#201 desc"
msgid ""
"ギデオンに雇われた武装集団。\n"
"ミラのために命を賭ける\n"
"傭兵稼業に明け暮れている。"
msgstr ""

#. Azure Knight
msgctxt "#202 name"
msgid "蒼の騎神"
msgstr ""

#. Knight by the name of Ordine, 
#. with Crow as its Awakener. 
#. Fights with a double saber,
#. completely free of hesitation.
msgctxt "#202 desc"
msgid ""
"クロウを起動者とする\n"
"オルディーネと呼ばれる機体。\n"
"《Ｃ》として目的を果たすため\n"
"一片の迷いなく双刃剣を振るう。"
msgstr ""

#. Drakkhen
msgctxt "#203 name"
msgid "ドラッケン"
msgstr ""

#. A giant humanoid weapon made
#. by Reinford's 5th Development
#. Division. Mobile and strong,
#. it revolutionizes warfare.
msgctxt "#203 desc"
msgid ""
"ラインフォルト第五開発部が\n"
"完成させた人型有人兵器。\n"
"機動力と攻撃力を兼ね備え、\n"
"戦場に革命をもたらす。"
msgstr ""

#. Drakkhen
msgctxt "#204 name"
msgid "ドラッケン"
msgstr ""

#. A giant humanoid weapon made
#. by Reinford's 5th Development
#. Division. Mobile and strong,
#. it revolutionizes warfare.
msgctxt "#204 desc"
msgid ""
"ラインフォルト第五開発部が\n"
"完成させた人型有人兵器。\n"
"機動力と攻撃力を兼ね備え、\n"
"\n"
"戦場に革命をもたらす。"
msgstr ""

#. Drakkhen
msgctxt "#205 name"
msgid "ドラッケン"
msgstr ""

#. A giant humanoid weapon made
#. by Reinford's 5th Development
#. Division. Mobile and strong,
#. it revolutionizes warfare.
msgctxt "#205 desc"
msgid ""
"ラインフォルト第五開発部が\n"
"完成させた人型有人兵器。\n"
"機動力と攻撃力を兼ね備え、\n"
"\n"
"戦場に革命をもたらす。"
msgstr ""

#. Spiegel
msgctxt "#206 name"
msgid "シュピーゲル"
msgstr ""

#. A special Soldat operated by
#. Scarlet. Uses reactive armor
#. to nullify enemy attacks.
msgctxt "#206 desc"
msgid ""
"スカーレットが操縦する\n"
"《機甲兵》の隊長専用機体。\n"
"リアクティブアーマーを搭載し\n"
"あらゆる攻撃を無効化する。"
msgstr ""

#. Spiegel
msgctxt "#207 name"
msgid "シュピーゲル"
msgstr ""

#. A special Soldat operated by
#. Scarlet. Uses reactive armor
#. to nullify enemy attacks.
msgctxt "#207 desc"
msgid ""
"スカーレットが操縦する\n"
"《機甲兵》の隊長専用機体。\n"
"対戦車用の強力な装備を搭載する。"
msgstr ""

#. Spiegel
msgctxt "#208 name"
msgid "シュピーゲル"
msgstr ""

#. A special Soldat operated by
#. Scarlet. Uses reactive armor
#. to nullify enemy attacks.
msgctxt "#208 desc"
msgid ""
"スカーレットが操縦する\n"
"《機甲兵》の隊長専用機体。\n"
"対戦車用の強力な装備を搭載する。"
msgstr ""

#. Spiegel
msgctxt "#209 name"
msgid "シュピーゲル"
msgstr ""

#. A special Soldat operated by
#. Scarlet. Uses reactive armor
#. to nullify enemy attacks.
msgctxt "#209 desc"
msgid ""
"スカーレットが操縦する\n"
"《機甲兵》の隊長専用機体。\n"
"リアクティブアーマーを搭載し\n"
"あらゆる攻撃を無効化する。"
msgstr ""

#. Enemy
msgctxt "#210 name"
msgid "ザコ"
msgstr ""

#. A generic enemy for debug
#. purposes. Completely average.
msgctxt "#210 desc"
msgid ""
"デバッグ用ザコモンスター。\n"
"平均的な奴。"
msgstr ""

#. Strong Enemy
msgctxt "#211 name"
msgid "強ザコ"
msgstr ""

#  A generic strong enemy for
#. debug purposes. Reckless type.
msgctxt "#211 desc"
msgid ""
"デバッグ用強ザコモンスター。\n"
"猪突猛進型。"
msgstr ""

#. Boss
msgctxt "#212 name"
msgid "ボス"
msgstr ""

#. A generic boss enemy for debug
#. purposes. A mass of bones that
#. would make dogs happy.
msgctxt "#212 desc"
msgid ""
"デバッグ用ボスモンスター。\n"
"犬が喜ぶ骨っこ集合体。"
msgstr ""

#. Drome
msgctxt "#213 name"
msgid "ドローメ"
msgstr ""

#. A mollusk known for its cold
#. body. Freezes small animals
#. with cold air before feeding
#. on them.
msgctxt "#213 desc"
msgid ""
"冷たい体が特徴の軟体\n"
"魔獣。冷気を噴出して\n"
"小さな動物を凍結させ\n"
"てから捕食する。"
msgstr ""

#. Aldovoss
msgctxt "#214 name"
msgid "アルドヴォス"
msgstr ""

#. A hard-shelled fiend that
#. appeared from deep in a mine.
#. Pulverizes all those who come
#. near with its powerful arms.
msgctxt "#214 desc"
msgid ""
"鉱山の奥深くから現れた、\n"
"硬い甲殻に覆われた魔物。\n"
"豪腕を振り回して近づく者を\n"
"完膚なきまでに叩き潰す。"
msgstr ""

#. Bozuonga
msgctxt "#215 name"
msgid "ボズオンガ"
msgstr ""

#. Leader of a group of primates.
#. Swings its axe with incredible
#. force, summoning minions by
#. roaring.
msgctxt "#215 desc"
msgid ""
"群れのリーダー格たる大猿の魔物\n"
"凄まじい膂力から石斧を\n"
"繰り出すほか、咆哮を轟かせて\n"
"手下のコボンガを呼ぶ。"
msgstr ""

#. Aldovoss
msgctxt "#216 name"
msgid "アルドヴォス"
msgstr ""

#. A hard-shelled fiend that
#. appeared from deep in a mine.
#. Pulverizes all those who come
#. near with its powerful arms.
msgctxt "#216 desc"
msgid ""
"鉱山の奥深くから現れた、\n"
"硬い甲殻に覆われた魔物。\n"
"豪腕を振り回して近づく者を\n"
"完膚なきまでに叩き潰す。"
msgstr ""


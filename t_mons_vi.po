#. Grass Drome
msgctxt "#0 name"
msgid "グラスドローメ"
msgstr ""

#. A kind of spongy mollusk that
#. likes areas with high humidity.
#. Produces orbal energy in its
#. body and uses wind arts.
msgctxt "#0 desc"
msgid ""
"湿気のある場所を好む\n"
"ブヨブヨとした軟体魔獣。\n"
"体内から導力を生み出し\n"
"風属性のアーツを発動する。"
msgstr ""

#. Ice Drome
msgctxt "#1 name"
msgid "アイスドローメ"
msgstr ""

#. An icy cold mollusk that 
#. breeds in areas with lots of 
#. water. Creates orbal energy in 
#. its body and uses water arts.
msgctxt "#1 desc"
msgid ""
"水の多い場所に繁殖する\n"
"氷のように冷たい軟体魔獣。\n"
"体内から導力を生み出し\n"
"水属性のアーツを発動する。"
msgstr ""

#. Black Drome
msgctxt "#2 name"
msgid "ブラックドローメ"
msgstr ""

#. A mollusk as dark as the
#. abyss. Produces orbal 
#. energy in its body and 
#. uses time arts.
msgctxt "#2 desc"
msgid ""
"闇から生まれ出でたような\n"
"深淵の色をした軟体魔獣。\n"
"体内から導力を生み出し\n"
"時属性のアーツを発動する。"
msgstr ""

#. Flash Drome
msgctxt "#3 name"
msgid "フラッシュドローメ"
msgstr ""

#. Mollusk that gives off light 
#. and stores it as a nutrient. 
#. Creates orbal energy in its 
#. body and uses space arts.
msgctxt "#3 desc"
msgid ""
"光を養分として蓄え、\n"
"発光する性質を持つ軟体魔獣。\n"
"体内から導力を生み出し\n"
"空属性のアーツを発動する。"
msgstr ""

#. Magma Drome
msgctxt "#4 name"
msgid "マグマドローメ"
msgstr ""

#. A mollusk which draws in 
#. heat as a nutrient. Creates 
#. orbal energy in its body 
#. and uses fire arts.
msgctxt "#4 desc"
msgid ""
"周囲の熱を取り込み、\n"
"栄養とする軟体魔獣。\n"
"体内から導力を生み出し\n"
"火属性のアーツを発動する。"
msgstr ""

#. Giant Drome
msgctxt "#5 name"
msgid "ビッグドローメ"
msgstr ""

#. A giant mollusk which inhabits
#. Heimdallr's underground. 
#. Attacks all by causing the
#. surrounding space to vibrate.
msgctxt "#5 desc"
msgid ""
"帝都の地下に棲みついた\n"
"巨大な軟体魔獣。\n"
"空間を振動させて\n"
"周囲全てへの攻撃を行う。"
msgstr ""

#. Egg Snake
msgctxt "#6 name"
msgid "エッグスネーク"
msgstr ""

#. A reptilian monster that has
#. taken up living in the egg of
#. a large bird. Its fangs have
#. deadly poison inside them.
msgctxt "#6 desc"
msgid ""
"大型の鳥類の卵に棲みついた\n"
"爬虫類型の魔獣。\n"
"その牙には猛毒がある。"
msgstr ""

#. Rock Serpent
msgctxt "#7 name"
msgid "ロックサーペント"
msgstr ""

#. A serpent monster that lives
#. in an exceptionally hard egg
#. of a large bird. Its fangs can
#. petrify enemies.
msgctxt "#7 desc"
msgid ""
"岩のように硬い巨鳥の卵に\n"
"住み着いている蛇型魔獣。\n"
"牙には石化毒が含まれている。"
msgstr ""

#. Rhinocider
msgctxt "#8 name"
msgid "ライノサイダー"
msgstr ""

#. A monster covered by 
#. hardened skin. Its powerful 
#. charge attacks are strong 
#. enough to topple orbal cars.
msgctxt "#8 desc"
msgid ""
"全身を硬質化した\n"
"皮膚に覆われている魔獣。\n"
"強烈かつ強靭な突進攻撃は\n"
"導力車をもひっくり返す。"
msgstr ""

#. Goldcider
msgctxt "#9 name"
msgid "ゴルドサイダー"
msgstr ""

#. A monster covered in a golden,
#. armor-like shell. Its immense
#. weight gives its charge
#. attacks incredible power.
msgctxt "#9 desc"
msgid ""
"黄金色の鎧のような外殻を\n"
"身にまとった魔獣。\n"
"その超重量を叩きつけるような\n"
"突進攻撃は何者をも退ける。"
msgstr ""

#. Crop Muncher
msgctxt "#10 name"
msgid "畑あらし"
msgstr ""

#. A small monster that attacks
#. granaries. Be cautious of its
#. blinding sand attacks.
msgctxt "#10 desc"
msgid ""
"穀倉地帯の畑を狙う小型魔獣。\n"
"砂の目潰しを行うため要注意。"
msgstr ""

#. Grass Hopper
msgctxt "#11 name"
msgid "グラスホッパー"
msgstr ""

#. A relatively docile monster
#. that subsists off grass.
#. ...Or so you think, until it
#. kicks sand in your face.
msgctxt "#11 desc"
msgid ""
"草原の草を食んで暮らす\n"
"比較的大人しい魔獣。\n"
"……と見せかけて、突然\n"
"砂を投げつけてきたりする。"
msgstr ""

#. Pom
msgctxt "#12 name"
msgid "ポム"
msgstr ""

#. A dastardly fluff. Steals 
#. EP and CP from those 
#. who dare touch it.
msgctxt "#12 desc"
msgid ""
"なにかしらポムっとした存在。\n"
"触れた者からEPやCPを吸収する。"
msgstr ""

#. Grass Pom
msgctxt "#13 name"
msgid "わかくさポム"
msgstr ""

#. A subspecies of Pom that 
#. smells of fresh flowers. 
#. Absorbs CP and EP.
msgctxt "#13 desc"
msgid ""
"新緑の草花の香りがする\n"
"なにかしらポムっとした亜種。\n"
"CPやEPを吸収する能力を持つ。"
msgstr ""

#. Shining Pom
msgctxt "#14 name"
msgid "シャイニングポム"
msgstr ""

#. A shining, dastardly fluff 
#. that absorbs CP and EP. 
#. Bewitches its foes using 
#. the bright light it emits.
msgctxt "#14 desc"
msgid ""
"光り輝く何かしら\n"
"ポムっとした存在。\n"
"CPやEPを吸収する能力を持ち、\n"
"まばゆい光で敵を惑わす。"
msgstr ""

